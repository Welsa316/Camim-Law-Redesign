---
/**
 * Accordion gallery — a port of the React Bits `AccordionGallery` component.
 *
 * Ported rather than installed: the original is React, this site ships no
 * React, and the whole component is a GSAP timeline over `flex-grow` plus a
 * little state. Adding a framework runtime to render five panels would cost
 * more than the component is worth. GSAP is already here for the heading
 * reveals, so the marginal cost is zero.
 *
 * Faithful to the original's behaviour and props. Three deliberate changes:
 *
 *  1. Real list semantics. The original puts `role="listitem"` on the anchors,
 *     which overrides their link role and hides them from a screen reader's
 *     link list. This uses a genuine `ul`/`li` with the anchor inside.
 *  2. Grayscale defaults to off. These are photographs of a real person and of
 *     broadcast stills whose station colour is part of what makes them
 *     credible; desaturating a face and restoring it on hover reads as an
 *     effect applied to him.
 *  3. Captions are real text rather than `aria-hidden` decoration, so the
 *     label is available to assistive technology and to search.
 */

export interface GalleryLink {
  label: string;
  href: string;
  /** A small trailing note, e.g. a form number. */
  note?: string;
}

export interface GalleryItem {
  label: string;
  meta?: string;
  /** Primary destination for the panel. */
  link?: string;
  /** "01", "02"... Shown large on a text panel and in its collapsed tab. */
  ordinal?: string;
  /** Sub-links listed inside an open text panel. */
  links?: GalleryLink[];
  /** A short trailing label on an open image panel, e.g. "Leer más". */
  more?: string;
  /**
   * Imagery is optional. Without it the panel is typographic: a ground, an
   * ordinal, the label, the line and the sub-links, with a vertical tab that
   * names the panel while it is collapsed. That variant exists because the
   * only per-service photography available was stock, and it was rejected.
   */
  image?: string;
  width?: number;
  height?: number;
  alt?: string;
  /**
   * Focal point, as an `object-position` value. Required with an image: a
   * fixed-width media box centred in a narrow panel crops a tall portrait
   * straight through the head, and a face cut off at the eyeline is the one
   * framing error a reader always notices.
   */
  focus?: string;
}

interface Props {
  items: GalleryItem[];
  defaultIndex?: number;
  height?: number;
  gap?: number;
  radius?: number;
  expandRatio?: number;
  duration?: number;
  ease?: string;
  parallax?: number;
  tilt?: number;
  stagger?: number;
  trigger?: "hover" | "click";
  grayscale?: boolean;
  id?: string;
}

const {
  items,
  defaultIndex = 0,
  height = 520,
  gap = 8,
  radius = 4,
  expandRatio = 0.52,
  duration = 0.6,
  ease = "power3.out",
  parallax = 0.5,
  tilt = 3,
  stagger = 0.06,
  trigger = "hover",
  grayscale = false,
  id = "gallery",
} = Astro.props;

const active = Math.min(Math.max(defaultIndex, 0), items.length - 1);
---

<ul
  class="ag"
  id={id}
  data-accordion-gallery
  data-default-index={active}
  data-height={height}
  data-gap={gap}
  data-expand-ratio={expandRatio}
  data-duration={duration}
  data-ease={ease}
  data-parallax={parallax}
  data-tilt={tilt}
  data-stagger={stagger}
  data-trigger={trigger}
  data-grayscale={String(grayscale)}
  data-count={items.length}
  style={`--ag-gap:${gap}px; --ag-radius:${radius}px; --ag-height:${height}px;`}
>
  {items.map((item, i) => (
    <li
      class="ag-item"
      data-ag-panel
      data-index={i}
      data-active={i === active ? "" : undefined}
      data-text={item.image ? undefined : ""}
    >
      {item.image ? (
        <a class="ag-link" href={item.link ?? `#${id}`} aria-current={i === active ? "true" : undefined}>
          {(item.ordinal || item.label) && (
            <span class="ag-tab ag-tab--dark" aria-hidden="true">
              {item.ordinal && <span class="ag-tab-n">{item.ordinal}</span>}
              <span class="ag-tab-l">{item.label}</span>
            </span>
          )}
          <span class="ag-frame">
            <span class="ag-media" data-ag-media>
              <img
                src={item.image}
                width={item.width}
                height={item.height}
                alt={item.alt ?? ""}
                style={`object-position:${item.focus ?? "50% 50%"};`}
                loading={i === active ? "eager" : "lazy"}
                decoding="async"
                draggable="false"
              />
            </span>
            <span class="ag-overlay" aria-hidden="true"></span>
          </span>
          <span class="ag-caption">
            <span class="ag-bar" data-ag-bar aria-hidden="true"></span>
            <span class="ag-text" data-ag-text>
              {item.ordinal && <span class="ag-n ag-n--dark apparatus">{item.ordinal}</span>}
              <span class="ag-label">{item.label}</span>
              {item.meta && <span class="ag-meta">{item.meta}</span>}
              {item.more && <span class="ag-more apparatus">{item.more}<span aria-hidden="true"> &rarr;</span></span>}
            </span>
          </span>
        </a>
      ) : (
        <div class="ag-link ag-link--text">
          {/* Names the panel while it is collapsed. Decorative: the same words
              are in the caption below, which stays in the accessibility tree
              whatever its opacity. */}
          <span class="ag-tab" aria-hidden="true">
            {item.ordinal && <span class="ag-tab-n">{item.ordinal}</span>}
            <span class="ag-tab-l">{item.label}</span>
          </span>
          <div class="ag-caption ag-caption--text">
            <span class="ag-bar" data-ag-bar aria-hidden="true"></span>
            <div class="ag-text" data-ag-text>
              {item.ordinal && <span class="ag-n apparatus">{item.ordinal}</span>}
              <h3 class="ag-label ag-label--text">
                {item.link ? <a class="ag-title-link" href={item.link}>{item.label}</a> : item.label}
              </h3>
              {item.meta && <p class="ag-line">{item.meta}</p>}
              {item.links && item.links.length > 0 && (
                <ul class="ag-links">
                  {item.links.map((l) => (
                    <li>
                      <a class="ag-sub" href={l.href}>
                        <span>{l.label}</span>
                        {l.note && <span class="ag-note apparatus">{l.note}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </div>
      )}
    </li>
  ))}
</ul>

<style>
  .ag {
    --ag-gap: 8px;
    --ag-radius: 4px;
    --ag-height: 520px;
    --ag-media-size: 340px;
    list-style: none;
    display: flex;
    gap: var(--ag-gap);
    width: 100%;
    height: var(--ag-height);
    perspective: 1600px;
    margin: 0;
    padding: 0;
  }

  .ag-item {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    transform-style: preserve-3d;
    transform-origin: center center;
    will-change: flex-grow, transform;
  }

  .ag-link {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    border-radius: var(--ag-radius);
    background: var(--color-navy-deep);
    text-decoration: none;
    color: var(--color-paper);
    -webkit-tap-highlight-color: transparent;
  }
  .ag-link:focus-visible {
    outline: 2px solid var(--color-paper);
    outline-offset: 3px;
  }

  .ag-frame { position: absolute; inset: 0; overflow: hidden; border-radius: inherit; }

  .ag-media {
    --ag-gray: 0;
    --ag-dim: 0.42;
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--ag-media-size);
    height: 100%;
    transform: translate(-50%, -50%);
    filter: grayscale(var(--ag-gray));
    will-change: transform, filter;
  }
  .ag-media img { width: 100%; height: 100%; object-fit: cover; display: block; user-select: none; }

  .ag-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, transparent 30%, rgb(11 31 51 / 0.55) 62%, rgb(11 31 51 / 0.92) 100%),
      rgb(11 31 51 / var(--ag-dim, 0.42));
  }
  /* A collapsed panel carries its name up its left edge, over whatever part
     of the photograph happens to be there. This wash sits under that edge
     only; measured: the label read 2.6:1 over the passport's pale table
     without it. */
  .ag-item:not([data-active]) .ag-overlay {
    background:
      linear-gradient(90deg, rgb(11 31 51 / 0.86) 0%, rgb(11 31 51 / 0.55) 34%, rgb(11 31 51 / 0) 70%),
      linear-gradient(180deg, transparent 30%, rgb(11 31 51 / 0.55) 62%, rgb(11 31 51 / 0.92) 100%),
      rgb(11 31 51 / var(--ag-dim, 0.42));
  }

  .ag-caption {
    position: absolute;
    left: var(--spacing-s5);
    right: var(--spacing-s5);
    bottom: var(--spacing-s5);
    z-index: 3;
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-s3);
    z-index: 2;
    pointer-events: none;
  }
  .ag-bar {
    flex: 0 0 auto;
    width: 2px;
    height: 2.4em;
    background: var(--color-brass-light);
    opacity: 0;
  }
  .ag-text { display: grid; gap: 2px; min-width: 0; opacity: 0; }
  .ag-label {
    font-size: var(--text-h4);
    font-weight: var(--font-weight-semibold);
    line-height: 1.25;
    color: var(--color-paper);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.5);
  }
  .ag-meta { color: #dbe3ea; text-shadow: 0 1px 10px rgb(0 0 0 / 0.5); font-size: var(--text-base); line-height: 1.45; max-width: 38ch; }
  /* Paper, not brass: a 15px brass ordinal over the mid-tones of a photograph
     measured 2.8-3.2:1. The brass stays on the bar and on the collapsed tab,
     which sit over the edge wash. */
  .ag-text .ag-n--dark { color: var(--color-paper); }
  .ag-more { color: var(--color-brass-light); margin-top: var(--spacing-s2); }
  /* the collapsed tab on a photograph: light type, and it fades as the panel opens */
  .ag-tab--dark { z-index: 2; }
  .ag-tab--dark .ag-tab-n { color: var(--color-brass-light); }
  .ag-tab--dark .ag-tab-l { color: var(--color-paper); text-shadow: 0 1px 12px rgb(0 0 0 / 0.55); }

  /* Below the breakpoint the accordion is a stack: an accordion whose panels
     are 60px wide tells a phone user nothing, and hiding options behind a
     hover a phone does not have is how a visitor loses the thing they came
     for. Every panel is open, captioned, and tappable. */
  @media (max-width: 767px) {
    .ag {
      flex-direction: column;
      height: auto;
      perspective: none;
      gap: var(--spacing-s4);
    }
    .ag-item { flex: none; transform: none !important; }
    /* Stacked, the caption is in flow and the panel is as tall as the caption
       needs, with the photograph filling whatever that height is. A fixed
       aspect ratio put a five-line caption over the top edge of the panel. */
    .ag-link { position: relative; inset: auto; display: grid; align-items: end; min-height: 240px; }
    .ag-caption { position: relative; left: auto; right: auto; bottom: auto; padding: var(--spacing-s5); }
    .ag-media {
      position: absolute; width: 100%; height: 100%;
      transform: translate(-50%, -50%) !important;
      filter: none !important;
    }
    .ag-overlay, .ag-item:not([data-active]) .ag-overlay {
      background: linear-gradient(180deg, rgb(11 31 51 / 0.58) 0%, rgb(11 31 51 / 0.72) 50%, rgb(11 31 51 / 0.92) 100%);
    }
    .ag-bar, .ag-text { opacity: 1 !important; transform: none !important; }
  }

  /* --- text panels ------------------------------------------------------
     Same box, same motion, no photograph. A light ground on the section's own
     surface, the ordinal in the accent, the label in the serif. */
  .ag-link--text {
    background: var(--color-paper-2);
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    transition: background-color var(--d-state) var(--ease-state),
                border-color var(--d-state) var(--ease-state);
  }
  .ag-item[data-active] .ag-link--text { background: var(--color-paper); border-color: var(--color-line-strong); }

  /* The collapsed tab: ordinal then name, running up the panel. */
  .ag-tab {
    position: absolute; left: 0; top: 0; bottom: 0;
    display: flex; align-items: flex-end; gap: var(--spacing-s3);
    padding: var(--spacing-s5) var(--spacing-s4);
    writing-mode: vertical-rl; transform: rotate(180deg);
    white-space: nowrap;
    pointer-events: none;
    transition: opacity var(--d-state) var(--ease-state);
  }
  .ag-item[data-active] .ag-tab { opacity: 0; }
  .ag-tab-n {
    font-family: var(--font-mono); font-size: var(--text-eyebrow);
    letter-spacing: 0.12em; color: var(--color-accent-ink);
  }
  .ag-tab-l {
    font-family: var(--font-serif); font-size: var(--text-h4); line-height: 1;
    letter-spacing: -0.01em; color: var(--color-ink);
  }

  .ag-caption--text {
    top: var(--spacing-s5); bottom: auto;
    left: var(--spacing-s5); right: var(--spacing-s5);
    pointer-events: auto;              /* the links inside are real links */
    max-width: 44ch;
  }
  .ag-caption--text .ag-bar { background: var(--color-accent-ink); height: 3.2em; }
  .ag-caption--text .ag-text { gap: var(--spacing-s2); }
  .ag-n { color: var(--color-accent-ink); }
  .ag-label--text {
    margin: 0;
    font-family: var(--font-serif); font-size: var(--text-h3); line-height: 1.1;
    letter-spacing: -0.015em; font-weight: 400; color: var(--color-ink);
    text-shadow: none;
  }
  /* Inline-block with vertical padding so the heading link is a 44px target
     on a phone, where it is tapped, without changing the line box on desktop. */
  .ag-title-link { display: inline-block; color: inherit; text-decoration: none; padding-block: 10px; margin-block: -10px; }
  @media (any-hover: hover) { .ag-title-link:hover { color: var(--color-accent-ink); } }
  .ag-line { margin: 0; color: var(--color-ink-2); font-size: var(--text-base); line-height: 1.5; max-width: 40ch; }
  .ag-links { list-style: none; margin: var(--spacing-s3) 0 0; padding: 0; display: grid; }
  .ag-sub {
    display: flex; align-items: baseline; justify-content: space-between; gap: var(--spacing-s3);
    min-height: 40px; padding-block: var(--spacing-s2);
    border-top: 1px solid var(--color-line);
    color: var(--color-ink); text-decoration: none; font-size: var(--text-base);
  }
  .ag-links li:last-child .ag-sub { border-bottom: 1px solid var(--color-line); }
  @media (any-hover: hover) { .ag-sub:hover { color: var(--color-accent-ink); } }
  .ag-sub:focus-visible, .ag-title-link:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 2px; }
  .ag-note { color: var(--color-ink-2); }

  /* A set of one is not an accordion. The production build currently has a
     single confirmed practice group, so on the live site this is the normal
     case, not an edge case: the one panel lays out as a plain block at every
     width, exactly as the stacked phone layout does, and the script never
     runs for it (it bails below two panels). */
  .ag[data-count="1"] { display: block; height: auto; perspective: none; }
  .ag[data-count="1"] .ag-item { transform: none; }
  .ag[data-count="1"] .ag-link { position: relative; inset: auto; }
  .ag[data-count="1"] .ag-link--text { max-width: var(--container-m-lead, 60ch); }
  .ag[data-count="1"] .ag-tab { display: none; }
  .ag[data-count="1"] .ag-caption--text { position: static; max-width: none; padding: var(--spacing-s5); }
  .ag[data-count="1"] .ag-caption--text .ag-bar { display: none; }
  .ag[data-count="1"] .ag-text { opacity: 1; }

  @media (max-width: 767px) {
    /* Stacked, every text panel is open: the tab is redundant and the
       caption is static content, not an overlay. */
    .ag-item[data-text] .ag-link--text { aspect-ratio: auto; position: relative; }
    .ag-tab { display: none; }
    .ag-caption--text { position: static; max-width: none; padding: var(--spacing-s5); }
    .ag-caption--text .ag-bar { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ag-item, .ag-media { will-change: auto; }
  }
</style>
