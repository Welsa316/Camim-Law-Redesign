---
import Base from "../layouts/Base.astro";
import { t, langPath, type Lang } from "../i18n/ui";
import { ORG, show } from "../lib/org";
import { SERVICES } from "../lib/services";
import { graph, orgSchema, breadcrumbSchema } from "../lib/seo";
import { demoAllows } from "../lib/site.js";

/* camulaw.com's consultation page strings, form labels and validation
   messages; record values. The fields are the proposal's: topic, name, phone
   and preferred language. No email field: the proposal does not ask for one,
   and neither firm's site words an error for a mistyped address. The form
   asks for no account of the case (Rule 4-1.18).

   The three ways in come first, as tiles; then a two-step card: the matter,
   chosen from a list that stays tucked away until it is opened, and then the
   person's details. A practice page's "book" button opens the card at the
   second step with its matter already chosen (?tema=<slug>). */
interface Props { lang: Lang }
const { lang } = Astro.props;
const _ = t(lang);
const whatsapp = show(ORG.whatsapp);
const path = langPath(lang, "consulta");
const alternates = { es: "/consulta/", en: "/en/consulta/" };
const crumbs = [{ name: _("nav.home"), url: langPath(lang) }, { name: _("nav.consultation"), url: path }];
const schema = graph([orgSchema(), breadcrumbSchema(crumbs)]);
const addr = ORG.address.value;
const topics = [...SERVICES.map((s) => ({ v: s.slug, n: s.name[lang] })), { v: "otro", n: _("form.notSure") }];
---
<Base lang={lang} title={`${_("contact.title")} — ${ORG.name.value}`} description={_("contact.subtitle")} path={path} alternates={alternates} schema={schema}>

  <nav class="crumbs wrap-wide">
    <ol>
      <li>{demoAllows("") ? <a href={langPath(lang)}>{_("nav.home")}</a> : <span>{_("nav.home")}</span>}</li>
      <li><span aria-current="page">{_("nav.consultation")}</span></li>
    </ol>
  </nav>

  <section class="chead wrap-wide" data-surface="paper">
    <h1 class="h1 chead-title" data-split-lines="hero">{_("contact.title")}</h1>
    <p class="lead">{_("contact.subtitle")}</p>
    <p class="apparatus chead-meta">{_("contact.confidential")} <span aria-hidden="true">&middot;</span> {_("contact.virtual")}</p>
  </section>

  <section class="wrap-wide tiles" aria-label={_("contact.contact")}>
    <a class="tile" href={`tel:${ORG.phone.value}`}>
      <svg class="tile-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z" fill="currentColor"/></svg>
      <span class="tile-label">{_("cta.call")}</span>
      <span class="tile-meta apparatus">{ORG.phoneDisplay.value}</span>
    </a>
    {whatsapp && (
      <a class="tile" href={whatsapp} rel="noopener">
        {/* The WhatsApp glyph, as published in WhatsApp's brand resources. */}
        <svg class="tile-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2m4.52 11.99c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74 1.71.74 2.38.8 3.24.67.52-.08 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18l-.47-.21"/></svg>
        <span class="tile-label">{_("cta.whatsapp")}</span>
        <span class="tile-meta apparatus">WhatsApp</span>
      </a>
    )}
    <a class="tile tile--primary" href="#formulario">
      <svg class="tile-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 3v2M17 3v2M4 8h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm4 8h6m-6 3h4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
      <span class="tile-label">{_("cta.book")}</span>
      <span class="tile-meta apparatus">{_("form.type")} <span aria-hidden="true">&darr;</span></span>
    </a>
  </section>

  <section class="wrap-wide formband" id="formulario">
    <div class="card" data-stepper data-step="1" data-widget-clear>
      <ol class="stepdots" aria-hidden="true">
        <li class="dot" data-dot="1">1</li>
        <li class="stepline"><i></i></li>
        <li class="dot" data-dot="2">2</li>
      </ol>

      <div class="viewport" data-viewport>
        <form
          class="form"
          method="post"
          action="/api/contact"
          data-contact-form
          data-phone={ORG.phone.value}
          data-phone-display={ORG.phoneDisplay.value}
          data-sending-label={_("form.sending")}
          data-success-message={_("form.success")}
          data-failure-message={_("form.failure")}
          data-ratelimit-message={_("form.rateLimit")}
          data-required-message={_("form.required")}
          data-phone-message={_("form.badPhone")}
        >
          <fieldset class="panel" data-panel="1">
            <legend class="panel-title" id="topic-legend">{_("form.type")}</legend>
            <div class="picker" data-picker>
              <button type="button" class="picker-btn" aria-expanded="false" aria-controls="topic-list" data-picker-btn>
                <span class="picker-value" data-picker-value>{_("form.selectType")}</span>
                <svg class="picker-chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="picker-list" id="topic-list" data-picker-list hidden>
                <div class="topics" role="radiogroup" aria-labelledby="topic-legend">
                  {topics.map((tp) => (
                    <label class="topic">
                      <input type="radio" name="topic" value={tp.v} />
                      <span class="topic-name">{tp.n}</span>
                      <span class="topic-arrow" aria-hidden="true">&rarr;</span>
                    </label>
                  ))}
                </div>
              </div>
            </div>
          </fieldset>

          <div class="panel" data-panel="2">
            <button type="button" class="chosen" data-back>
              <span class="chosen-label apparatus">{_("form.type")}</span>
              <span class="chosen-name" data-chosen></span>
              <span class="chosen-edit" aria-hidden="true">&#9998;</span>
            </button>
            <p class="form-alert" data-form-alert role="alert" hidden></p>
            <div class="row2">
              <div class="field">
                <label for="firstName">{_("form.firstName")} <span class="req" aria-hidden="true">*</span></label>
                <input id="firstName" name="firstName" type="text" autocomplete="given-name" required />
              </div>
              <div class="field">
                <label for="lastName">{_("form.lastName")}</label>
                <input id="lastName" name="lastName" type="text" autocomplete="family-name" />
              </div>
            </div>
            <div class="field">
              <label for="phone">{_("form.phone")} <span class="req" aria-hidden="true">*</span></label>
              <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required aria-describedby="phone-err" />
              <p class="field-err" id="phone-err" data-field-error></p>
            </div>
            <fieldset class="seg">
              <legend>{_("lang.es")} / {_("lang.en")}</legend>
              <div class="seg-track">
                <span class="seg-thumb" aria-hidden="true"></span>
                <label><input type="radio" name="preferredLanguage" value="es" checked={lang === "es"} /><span>{_("lang.es")}</span></label>
                <label><input type="radio" name="preferredLanguage" value="en" checked={lang === "en"} /><span>{_("lang.en")}</span></label>
              </div>
            </fieldset>
            <button class="btn btn-primary send" type="submit" data-send>
              <span class="send-label" data-send-label>{_("form.send")}</span>
              <span class="mark" aria-hidden="true"><svg viewBox="0 0 24 24"><circle class="mark-ring" cx="12" cy="12" r="9"/><path class="mark-check" d="M7.5 12.5l3 3 6-6.5"/></svg></span>
            </button>
            <p class="form-error" data-form-error hidden></p>
          </div>
        </form>

        <!-- Outside the form, so that nothing that hides the form can hide
             the thanks with it (it once did, and a sent form ended on nothing). -->
        <div class="panel done" data-panel="3" data-form-status tabindex="-1">
          <span class="done-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M7.5 12.5l3 3 6-6.5"/></svg></span>
          <p class="done-text">{_("form.success")}</p>
        </div>
      </div>
    </div>
    <p class="office apparatus">{addr.street} <span aria-hidden="true">&middot;</span> {addr.locality}, {addr.region} <span aria-hidden="true">&middot;</span> {_("contact.monFri")} {ORG.hours.value.opens}&ndash;{ORG.hours.value.closes}</p>
  </section>
</Base>

<style>
  /* One left edge with the logo, as on every other inner page. */
  .chead { padding-block: var(--spacing-s6) 0; display: grid; gap: var(--spacing-s4); justify-items: start; }
  .chead p { margin: 0; }
  .chead-title { margin: 0; max-width: 16ch; }
  .chead-meta { color: var(--surface-ink-2); }

  /* --- the three ways in ---------------------------------------------------- */
  .tiles { display: grid; gap: var(--spacing-s3); padding-block: var(--spacing-s7) var(--spacing-s6); }
  @media (min-width: 768px) { .tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--spacing-s4); } }
  .tile {
    display: grid; gap: var(--spacing-s2); align-content: start;
    min-height: 168px; padding: var(--spacing-s5);
    border: 1px solid var(--color-line); border-radius: 18px; background: var(--color-paper);
    color: var(--color-ink); text-decoration: none;
    transition: border-color var(--d-quick) var(--ease-state), background-color var(--d-quick) var(--ease-state);
  }
  /* Hover changes the border in place; nothing lifts. */
  @media (any-hover: hover) { .tile:hover { border-color: var(--color-ink); } }
  .tile:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .tile-ico { width: 44px; height: 44px; padding: 10px; border-radius: 12px; background: var(--color-paper-2); color: var(--color-navy); }
  .tile-label { font-size: var(--text-h4); font-weight: var(--font-weight-semibold); line-height: 1.25; margin-top: var(--spacing-s6); }
  .tile-meta { color: var(--color-ink-2); font-size: var(--text-sm); }
  .tile--primary { background: var(--color-navy); border-color: var(--color-navy); color: var(--color-paper); }
  .tile--primary .tile-ico { background: rgb(255 255 255 / 0.12); color: var(--color-paper); }
  .tile--primary .tile-meta { color: #c9d3de; }
  @media (any-hover: hover) { .tile--primary:hover { border-color: var(--color-navy-deep); background: var(--color-navy-deep); } }
  /* On a phone the bar at the bottom already calls and opens WhatsApp, so the
     tiles shrink to one compact row each rather than three tall cards. */
  @media (max-width: 767px) {
    .tile { min-height: 0; grid-template-columns: auto minmax(0, 1fr); grid-template-rows: auto auto; column-gap: var(--spacing-s4); row-gap: 2px; align-items: center; padding: var(--spacing-s4); }
    .tile-ico { grid-row: 1 / span 2; }
    .tile-label { margin-top: 0; }
  }

  /* --- the card ------------------------------------------------------------ */
  .formband { padding-block: var(--spacing-s4) clamp(64px, 7vw, 120px); display: grid; gap: var(--spacing-s5); justify-items: start; }
  .card {
    width: 100%; max-width: 40rem; padding: var(--spacing-s6) var(--spacing-s5);
    border: 1px solid var(--color-line); border-radius: 22px; background: var(--color-paper);
  }
  @media (min-width: 640px) { .card { padding: var(--spacing-s7); } }
  .stepdots { list-style: none; margin: 0 0 var(--spacing-s6); padding: 0; display: flex; align-items: center; gap: var(--spacing-s3); }
  .dot { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; font-family: var(--font-mono); font-size: 14px;
         background: var(--color-paper-2); color: var(--color-ink-2); transition: background-color var(--d-state), color var(--d-state); }
  .dot[data-state] { background: var(--color-navy); color: var(--color-paper); }
  .stepline { flex: 1; height: 2px; border-radius: 2px; background: var(--color-line); overflow: hidden; }
  .stepline i { display: block; height: 100%; width: 100%; background: var(--color-navy); transform: scaleX(0); transform-origin: left; transition: transform .45s cubic-bezier(.2,.8,.2,1); }
  .card:not([data-step="1"]) .stepline i { transform: none; }

  /* Panels slide sideways inside a frame whose height follows the current one. */
  .viewport { position: relative; overflow: hidden; transition: height .45s cubic-bezier(.2,.8,.2,1); }
  .form { margin: 0; }
  .panel { position: absolute; inset: 0 0 auto 0; border: 0; margin: 0; padding: 0; min-width: 0;
           transition: transform .45s cubic-bezier(.2,.8,.2,1), opacity .3s ease-out, visibility 0s .45s; }
  .panel[data-pos="here"] { transition: transform .45s cubic-bezier(.2,.8,.2,1), opacity .3s ease-out, visibility 0s 0s; }
  .panel[data-pos="left"] { transform: translateX(-60%); opacity: 0; visibility: hidden; pointer-events: none; }
  .panel[data-pos="right"] { transform: translateX(60%); opacity: 0; visibility: hidden; pointer-events: none; }
  .panel-title { font-size: var(--text-h4); font-weight: var(--font-weight-semibold); margin-bottom: var(--spacing-s4); padding: 0; }

  /* The picker: one row showing the choice; the options open under it in a
     panel that scrolls on its own, so the page never has to. */
  .picker-btn { display: flex; align-items: center; gap: var(--spacing-s3); width: 100%; min-height: 56px; padding: 0 var(--spacing-s4);
                border: 1px solid var(--color-line-strong); border-radius: 12px; background: var(--color-paper);
                font: inherit; font-size: var(--text-base); color: var(--color-ink); text-align: left; cursor: pointer;
                transition: border-color var(--d-quick) var(--ease-state); }
  @media (any-hover: hover) { .picker-btn:hover { border-color: var(--color-ink); } }
  .picker-btn:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .picker-value { flex: 1; }
  .picker-btn:not([data-chosen]) .picker-value { color: var(--color-ink-2); }
  .picker-chev { width: 20px; height: 20px; flex: none; color: var(--color-ink-2); transition: transform var(--d-quick) var(--ease-state); }
  .picker-btn[aria-expanded="true"] { border-color: var(--color-navy); border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
  .picker-btn[aria-expanded="true"] .picker-chev { transform: rotate(180deg); }
  .picker-list { max-height: min(20rem, 52vh); overflow-y: auto; overscroll-behavior: contain;
                 border: 1px solid var(--color-navy); border-top: 0; border-radius: 0 0 12px 12px; background: var(--color-paper);
                 animation: picker-open .18s ease-out; }
  @keyframes picker-open { from { opacity: 0; } to { opacity: 1; } }
  .topics { display: grid; padding-block: var(--spacing-s1); }
  .topic { position: relative; display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: center; gap: var(--spacing-s4);
           min-height: 48px; padding-inline: var(--spacing-s4); cursor: pointer; }
  .topic input { position: absolute; opacity: 0; pointer-events: none; }
  .topic::before { content: ""; position: absolute; inset: 2px 6px; border-radius: 8px; background: var(--color-paper-2); opacity: 0; transition: opacity .15s; }
  .topic > span { position: relative; }
  .topic-arrow { color: var(--color-accent-ink); opacity: 0; transition: opacity .15s; }
  .topic:hover::before, .topic:has(input:focus-visible)::before, .topic:has(input:checked)::before { opacity: 1; }
  .topic:hover .topic-arrow, .topic:has(input:focus-visible) .topic-arrow, .topic:has(input:checked) .topic-arrow { opacity: 1; }
  .topic:has(input:focus-visible) { outline: 2px solid var(--focus); outline-offset: -4px; border-radius: 10px; }

  .chosen { display: flex; align-items: baseline; gap: var(--spacing-s3); flex-wrap: wrap; width: 100%; text-align: left;
            min-height: 48px; padding: var(--spacing-s3) var(--spacing-s4); margin-bottom: var(--spacing-s5);
            border: 1px solid var(--color-line); border-radius: 12px; background: var(--color-paper-2);
            font: inherit; color: inherit; cursor: pointer; transition: border-color var(--d-quick) var(--ease-state); }
  @media (any-hover: hover) { .chosen:hover { border-color: var(--color-ink); } }
  .chosen:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .chosen-label { color: var(--color-ink-2); font-size: 12px; }
  .chosen-name { font-weight: var(--font-weight-semibold); }
  .chosen-edit { margin-left: auto; color: var(--color-accent-ink); }

  .form-alert, .form-error { margin: 0 0 var(--spacing-s4); padding: var(--spacing-s3) var(--spacing-s4);
                             border-left: 2px solid var(--color-accent-ink); background: var(--color-paper-2); }
  .form-error { margin: var(--spacing-s4) 0 0; }

  .row2 { display: grid; gap: 0 var(--spacing-s4); }
  @media (min-width: 560px) { .row2 { grid-template-columns: 1fr 1fr; } }
  .field { display: grid; gap: var(--spacing-s2); margin-bottom: var(--spacing-s4); min-width: 0; }
  .field label { font-size: var(--text-sm); font-weight: var(--font-weight-medium); }
  .req { color: var(--color-accent-ink); }
  .field input { min-height: 48px; padding: 0 var(--spacing-s4); font: inherit; font-size: var(--text-base); color: var(--color-ink);
                 border: 1px solid var(--color-line-strong); border-radius: 10px; background: var(--color-paper); width: 100%;
                 transition: border-color var(--d-quick) var(--ease-state); }
  @media (any-hover: hover) { .field input:hover { border-color: var(--surface-ink-2); } }
  .field input:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .field input[aria-invalid="true"] { border-color: var(--color-accent-ink); box-shadow: inset 0 0 0 1px var(--color-accent-ink); }
  .field-err { margin: 0; font-size: var(--text-sm); color: var(--color-accent-ink); }
  .field-err:empty { display: none; }

  /* The language: a thumb that slides under the chosen option. */
  .seg { border: 0; padding: 0; margin: 0 0 var(--spacing-s5); }
  .seg legend { font-size: var(--text-sm); font-weight: var(--font-weight-medium); margin-bottom: var(--spacing-s2); padding: 0; }
  .seg-track { position: relative; display: grid; grid-template-columns: 1fr 1fr; padding: 4px; border-radius: 999px; background: var(--color-paper-2); max-width: 22rem; }
  .seg-thumb { position: absolute; top: 4px; bottom: 4px; left: 4px; width: calc(50% - 4px); border-radius: 999px; background: var(--color-paper);
               box-shadow: 0 1px 2px rgb(0 0 0 / .08), 0 4px 10px -6px rgb(11 31 51 / .4); transition: transform .4s cubic-bezier(.2,.8,.2,1); }
  .seg-track:has(input[value="en"]:checked) .seg-thumb { transform: translateX(100%); }
  .seg label { position: relative; display: grid; place-items: center; min-height: 44px; cursor: pointer; font-weight: var(--font-weight-medium); }
  .seg input { position: absolute; opacity: 0; }
  .seg label:has(input:focus-visible) { outline: 2px solid var(--focus); border-radius: 999px; }

  /* Sending: the label gives way to a ring that turns, then closes into a check. */
  .send { position: relative; width: 100%; min-height: 52px; border-radius: 999px; }
  .send:disabled { cursor: progress; }
  .mark { position: absolute; inset: 0; display: grid; place-items: center; opacity: 0; }
  .mark svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .mark-ring { stroke-dasharray: 57; stroke-dashoffset: 40; transform-origin: 12px 12px; animation: send-spin .8s linear infinite; }
  .mark-check { stroke-dasharray: 16; stroke-dashoffset: 16; }
  .send[data-state] .send-label { opacity: 0; }
  .send[data-state] .mark { opacity: 1; }
  .send[data-state="ok"] .mark-ring { animation: none; stroke-dashoffset: 0; transition: stroke-dashoffset .3s; }
  .send[data-state="ok"] .mark-check { stroke-dashoffset: 0; transition: stroke-dashoffset .35s .1s; }
  @keyframes send-spin { to { transform: rotate(360deg); } }

  .done { display: grid; justify-items: center; text-align: center; gap: var(--spacing-s4); padding-block: var(--spacing-s5); }
  .done:focus { outline: none; }
  .done:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; border-radius: 12px; }
  .done-mark svg { width: 56px; height: 56px; fill: none; stroke: var(--color-navy); stroke-width: 1.6; stroke-linecap: round; }
  .done-text { margin: 0; font-size: var(--text-lead); max-width: 26ch; }

  .office { margin: 0; color: var(--color-ink-2); }
  .office span { margin-inline: var(--spacing-s1); }

  @media (prefers-reduced-motion: reduce) {
    .panel, .picker-list, .seg-thumb, .stepline i, .viewport, .picker-chev { transition: none !important; animation: none !important; }
    .mark-ring { animation-duration: 2.4s; }
  }
</style>
