---
import Base from "../layouts/Base.astro";
import Section from "./Section.astro";
import { t, langPath, type Lang } from "../i18n/ui";
import { ORG, show, mapEmbedUrl } from "../lib/org";
import { liveGroups } from "../lib/services";
import { graph, orgSchema, breadcrumbSchema } from "../lib/seo";

interface Props { lang: Lang }
const { lang } = Astro.props;
const _ = t(lang);
const es = lang === "es";
const path = langPath(lang, es ? "consulta" : "consultation");
const alternates = { es: "/consulta/", en: "/en/consultation/" };
const consultation = show(ORG.consultation);
const whatsapp = show(ORG.whatsapp);
const groups = liveGroups();

const copy = es
  ? {
      title: "Agendar una Consulta | Campos Immigration Law, Orlando",
      description:
        "Cómo funciona una consulta con Campos Immigration Law en Orlando: qué traer, qué pasa después y cómo contactarnos. Atendemos en español. (407) 418-9193.",
      h1: "Agendar una consulta",
      lead: "Una consulta es una conversación sobre su caso concreto: qué opciones tiene, qué riesgos hay y qué sigue. No es una venta.",
      costTitle: "Qué cuesta",
      costPending:
        "Confirmaremos el costo de la consulta antes de agendarla, y le diremos si las tarifas del gobierno van aparte. Nunca le cobraremos algo que no le hayamos dicho primero.",
      bringTitle: "Qué traer",
      bring: [
        "Su pasaporte o identificación, y los de su familia si el caso los incluye.",
        "Cualquier documento que le haya enviado el gobierno, aunque no lo entienda. Traiga el sobre completo.",
        "Fechas: cuándo entró al país, cuántas veces, cuándo salió si salió.",
        "Si tiene corte, la fecha y el papel donde aparece.",
        "Copia de cualquier solicitud que ya haya presentado, usted o alguien más por usted.",
      ],
      afterTitle: "Qué pasa después de escribirnos",
      after: [
        { t: "Recibimos su mensaje", d: "Le respondemos dentro del horario de oficina para acordar una hora." },
        { t: "Revisamos si podemos ayudarle", d: "Verificamos que no haya conflicto de interés y que su asunto sea de inmigración." },
        { t: "Hablamos de su caso", d: "Repasamos su historia, sus documentos y sus opciones reales. Sale sabiendo qué sigue." },
      ],
      formTitle: "Escríbanos",
      otherTitle: "Otras formas de contacto",
    }
  : {
      title: "Book a Consultation | Campos Immigration Law, Orlando",
      description:
        "How a consultation with Campos Immigration Law in Orlando works: what to bring, what happens next and how to reach us. Spanish and English. (407) 418-9193.",
      h1: "Book a consultation",
      lead: "A consultation is a conversation about your actual case: what options you have, what the risks are, and what happens next. It is not a sales call.",
      costTitle: "What it costs",
      costPending:
        "We will confirm the cost of the consultation before we book it, and tell you whether government filing fees are separate. We will never charge you something we have not told you about first.",
      bringTitle: "What to bring",
      bring: [
        "Your passport or identification, and your family's if the case involves them.",
        "Any document the government has sent you, even if you do not understand it. Bring the whole envelope.",
        "Dates: when you entered the country, how many times, when you left if you left.",
        "If you have a court date, the date and the paper it appears on.",
        "A copy of any application already filed, by you or by someone on your behalf.",
      ],
      afterTitle: "What happens after you write",
      after: [
        { t: "We receive your message", d: "We reply during office hours to agree a time." },
        { t: "We check whether we can help", d: "We confirm there is no conflict of interest and that your matter is an immigration one." },
        { t: "We go through your case", d: "Your account, your documents, your real options. You leave knowing what happens next." },
      ],
      formTitle: "Write to us",
      otherTitle: "Other ways to reach us",
    };

const crumbs = [
  { name: es ? "Inicio" : "Home", url: langPath(lang) },
  { name: _("nav.consultation"), url: path },
];
const schema = graph([orgSchema(), breadcrumbSchema(crumbs)]);
---
<Base lang={lang} title={copy.title} description={copy.description} path={path} alternates={alternates} schema={schema}>
  <section class="head wrap" data-surface="paper">
    <p class="eyebrow">{_("nav.consultation")}</p>
    <h1 class="h1" data-split-lines="hero">{copy.h1}</h1>
    <p class="lead">{copy.lead}</p>
  </section>

  <!-- Money in a sentence, not in a pricing card. -->
  <Section surface="paper-2">
    <div class="editorial">
      <div><p class="eyebrow">{copy.costTitle}</p></div>
      <div class="prose">
        <p>{consultation ? consultation.price : copy.costPending}</p>
      </div>
    </div>
  </Section>

  <Section surface="paper">
    <div class="editorial">
      <div><p class="eyebrow">{copy.afterTitle}</p></div>
      <ol class="steps">
        {copy.after.map((s) => (
          <li><div><p class="h4">{s.t}</p><p class="dim">{s.d}</p></div></li>
        ))}
      </ol>
    </div>
  </Section>

  <Section surface="paper" id="form">
    <div class="editorial">
      <div><p class="eyebrow">{copy.formTitle}</p></div>
      <div class="formwrap">
        <p class="notice form-caution">{_("disclaimer.form")}</p>

        <p class="form-status" data-form-status tabindex="-1" role="status" aria-live="polite"></p>

        <form
          class="form"
          data-contact-form
          action="/api/contact/"
          method="post"
          data-sending-label={_("form.sending")}
          data-success-message={_("form.success")}
          data-failure-message={_("form.failure")}
          data-phone={ORG.phone.value}
          data-phone-display={ORG.phoneDisplay.value}
        >
          <div class="form-grid">
            <p class="field">
              <label for="firstName">{_("form.firstName")} <span class="req">({_("form.required")})</span></label>
              <input id="firstName" name="firstName" type="text" autocomplete="given-name" required
                     data-validate data-err-required={_("form.errorRequired")} />
              <span class="field-err" data-field-error aria-live="polite"></span>
            </p>
            <p class="field">
              <label for="lastName">{_("form.lastName")}</label>
              <input id="lastName" name="lastName" type="text" autocomplete="family-name" />
            </p>
            <p class="field">
              <label for="phone">{_("form.phone")} <span class="req">({_("form.required")})</span></label>
              <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required
                     data-validate data-err-required={_("form.errorRequired")} data-err-phone={_("form.errorPhone")} />
              <span class="field-err" data-field-error aria-live="polite"></span>
            </p>
            <p class="field">
              <label for="email">{_("form.email")}</label>
              <input id="email" name="email" type="email" inputmode="email" autocomplete="email"
                     data-validate data-err-email={_("form.errorEmail")} />
              <span class="field-err" data-field-error aria-live="polite"></span>
            </p>
          </div>

          <p class="field">
            <label for="topic">{_("form.topic")} <span class="req">({_("form.required")})</span></label>
            <select id="topic" name="topic" required data-validate data-err-required={_("form.errorRequired")}>
              <option value="">{_("form.topicPlaceholder")}</option>
              {groups.map((g) => <option value={g.id}>{g.situation[lang]}</option>)}
              <option value="otro">{es ? "Otro / no estoy seguro" : "Something else / not sure"}</option>
            </select>
            <span class="field-err" data-field-error aria-live="polite"></span>
          </p>

          <fieldset class="field field--radio">
            <legend>{_("form.language")}</legend>
            <label><input type="radio" name="preferredLanguage" value="es" checked /> Español</label>
            <label><input type="radio" name="preferredLanguage" value="en" /> English</label>
          </fieldset>

          <button class="btn btn-primary" type="submit">{_("form.send")}</button>
          <noscript>
            <p class="notice">
              {es ? "Si el formulario no funciona, llámenos al " : "If the form does not work, call us at "}
              <a href={`tel:${ORG.phone.value}`}>{ORG.phoneDisplay.value}</a>.
            </p>
          </noscript>
        </form>
      </div>
    </div>
  </Section>

  <Section surface="paper-2">
    <div class="editorial">
      <div><p class="eyebrow">{copy.bringTitle}</p></div>
      <ul class="bring">{copy.bring.map((b) => <li>{b}</li>)}</ul>
    </div>
  </Section>

  <Section surface="paper">
    <div class="editorial">
      <div><p class="eyebrow">{copy.otherTitle}</p></div>
      <div class="ways">
        <p><a class="btn btn-primary" href={`tel:${ORG.phone.value}`}>{_("cta.call")} {ORG.phoneDisplay.value}</a></p>
        {whatsapp && <p><a class="btn btn-secondary" href={whatsapp} rel="noopener">WhatsApp</a></p>}
        <address class="ways-addr">
          <a href={`mailto:${ORG.email.value}`}>{ORG.email.value}</a>
          <span>{ORG.address.value.street}</span>
          <span>{ORG.address.value.locality}, {ORG.address.value.region} {ORG.address.value.postalCode}</span>
          <span class="apparatus">
            {es ? "Lunes a viernes" : "Monday to Friday"} · {ORG.hours.value.opens}&ndash;{ORG.hours.value.closes}
          </span>
        </address>
        <iframe
          class="ways-map"
          src={mapEmbedUrl()}
          title={es ? "Mapa de la oficina de Campos Immigration Law en Orlando" : "Map of the Campos Immigration Law office in Orlando"}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </Section>
</Base>

<style>
  .head { padding-block: var(--spacing-s8) var(--spacing-s9); display: grid; gap: var(--spacing-s4); }
  .dim { color: var(--surface-ink-2); }
  .formwrap { max-width: var(--container-m-read); display: grid; gap: var(--spacing-s5); }
  .form-caution { border-left: 2px solid var(--surface-accent); padding-left: var(--spacing-s4); }
  .form { display: grid; gap: var(--spacing-s5); }
  .form-grid { display: grid; gap: var(--spacing-s5); }
  @media (min-width: 640px) { .form-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .field { display: grid; gap: var(--spacing-s2); margin: 0; }
  .field label { font-weight: var(--font-weight-medium); font-size: var(--text-sm); }
  .req { color: var(--surface-ink-2); font-weight: 400; }
  .field input, .field select {
    min-height: 48px; padding: var(--spacing-s3) var(--spacing-s4);
    font: inherit; font-size: var(--text-base); color: var(--color-ink);
    background: var(--color-paper); border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm); width: 100%;
  }
  .field input:focus-visible, .field select:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .field input[aria-invalid="true"], .field select[aria-invalid="true"] { border-color: var(--color-accent-ink); border-width: 2px; }
  .field-err:not(:empty) { font-size: var(--text-sm); color: var(--color-accent-ink); }
  .field--radio { border: 0; padding: 0; display: grid; gap: var(--spacing-s2); }
  .field--radio legend { font-weight: var(--font-weight-medium); font-size: var(--text-sm); padding: 0; margin-bottom: var(--spacing-s2); }
  .field--radio { display: flex; flex-wrap: wrap; gap: var(--spacing-s3) var(--spacing-s6); align-items: center; }
  .field--radio legend { flex: 1 0 100%; }
  .field--radio label {
    display: inline-flex; align-items: center; gap: var(--spacing-s3);
    min-height: 44px; font-weight: 400; font-size: var(--text-base);
    white-space: nowrap;
  }
  .field--radio input { width: 24px; height: 24px; accent-color: var(--color-navy); flex: none; }
  .form-status:empty { display: none; }
  .form-status { padding: var(--spacing-s4) var(--spacing-s5); border-left: 2px solid var(--surface-accent); background: var(--color-paper-2); }
  .form-status[data-state="error"] { border-left-color: var(--color-accent); }
  .bring { list-style: none; display: grid; gap: var(--spacing-s4); max-width: var(--container-m-read); }
  .bring > li { display: grid; grid-template-columns: 1.25rem 1fr; gap: var(--spacing-s3); }
  .bring > li::before { content: "\2014"; color: var(--surface-accent-ink); }
  .ways { display: grid; gap: var(--spacing-s4); justify-items: start; }
  .ways-addr { display: grid; gap: var(--spacing-s1); font-style: normal; }
  .ways-addr a { color: var(--surface-ink); display: inline-flex; align-items: center; min-height: 44px; }
  .ways-map {
    display: block; width: 100%; aspect-ratio: 4 / 3; min-height: 240px;
    margin-top: var(--spacing-s4);
    border: 1px solid var(--color-line); border-radius: var(--radius-sm);
    background: var(--color-paper-2);
    filter: saturate(0.85);
  }
</style>
