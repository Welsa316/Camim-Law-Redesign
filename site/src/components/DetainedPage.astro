---
import Base from "../layouts/Base.astro";
import Section from "./Section.astro";
import { t, langPath, type Lang } from "../i18n/ui";
import { ORG, COURT } from "../lib/org";
import { graph, orgSchema, breadcrumbSchema } from "../lib/seo";

interface Props { lang: Lang }
const { lang } = Astro.props;
const _ = t(lang);
const es = lang === "es";
const path = langPath(lang, es ? "detenido" : "detained");
const alternates = { es: "/detenido/", en: "/en/detained/" };

const copy = es
  ? {
      title: "Detuvieron a un Familiar | Qué Hacer Hoy | Orlando",
      description:
        "Qué hacer en las primeras horas si ICE detuvo a un familiar: qué información reunir, cómo localizarlo y a quién llamar. Campos Immigration Law, Orlando.",
      h1: "Detuvieron a un familiar. Qué hacer ahora.",
      lead: "Esta página es para las primeras horas. Está ordenada por lo que conviene hacer primero.",
      nowTitle: "Ahora mismo",
      now: [
        "Anote la hora y el lugar donde ocurrió, y quién estaba presente.",
        "No firme nada que no entienda, y dígale a su familiar que tampoco firme nada sin hablar con un abogado.",
        "Reúna la información de la lista de abajo antes de llamar a nadie. Le van a pedir exactamente eso.",
        "Llámenos. Si es fuera del horario de oficina, deje un mensaje con esa información y su número.",
      ],
      haveTitle: "Información que le van a pedir",
      have: [
        "Nombre completo, tal como aparece en sus documentos.",
        "Fecha de nacimiento.",
        "País de nacimiento.",
        "Número A, si lo tiene. Son nueve dígitos y empiezan con la letra A.",
        "Dónde y cuándo lo detuvieron.",
      ],
      findTitle: "Cómo localizarlo",
      findBody:
        "El gobierno tiene un localizador público de personas detenidas. Se busca por número A y país de nacimiento, o por nombre completo, fecha de nacimiento y país. Puede tardar horas o algún día en aparecer, así que si no sale a la primera, vuelva a intentarlo. Que no aparezca todavía no significa que no esté detenido.",
      helpTitle: "En qué podemos ayudar",
      help: [
        "Ubicar el caso y averiguar en qué etapa está.",
        "Revisar si hay opciones de fianza y qué haría falta para pedirla.",
        "Revisar qué defensas existen según la historia de la persona.",
        "Representarlo ante la corte de inmigración.",
      ],
      reachTitle: "Cómo contactarnos",
      courtNote: `Los casos de esta zona se ven en la Corte de Inmigración de Orlando, ${COURT.address}.`,
    }
  : {
      title: "A Relative Was Detained | What To Do Today | Orlando",
      description:
        "What to do in the first hours if ICE has detained a relative: what information to gather, how to locate them, and who to call. Campos Immigration Law, Orlando.",
      h1: "A relative has been detained. What to do now.",
      lead: "This page is for the first few hours. It is ordered by what is worth doing first.",
      nowTitle: "Right now",
      now: [
        "Write down the time and place it happened, and who was there.",
        "Do not sign anything you do not understand, and tell your relative not to sign anything without speaking to a lawyer.",
        "Gather the information in the list below before you call anyone. It is exactly what you will be asked for.",
        "Call us. Outside office hours, leave a message with that information and your number.",
      ],
      haveTitle: "Information you will be asked for",
      have: [
        "Full name, as it appears on their documents.",
        "Date of birth.",
        "Country of birth.",
        "A-number, if you have it. It is nine digits and begins with the letter A.",
        "Where and when they were detained.",
      ],
      findTitle: "How to locate them",
      findBody:
        "The government runs a public detainee locator. You search by A-number and country of birth, or by full name, date of birth and country. It can take hours or a day for someone to appear, so if nothing comes up the first time, try again. Not appearing yet does not mean they are not detained.",
      helpTitle: "How we can help",
      help: [
        "Locating the case and finding out what stage it is at.",
        "Checking whether bond is an option and what would be needed to request it.",
        "Reviewing what defences exist given the person's history.",
        "Representing them before the immigration court.",
      ],
      reachTitle: "How to reach us",
      courtNote: `Cases from this area are heard at the Orlando Immigration Court, ${COURT.address}.`,
    };

const crumbs = [
  { name: es ? "Inicio" : "Home", url: langPath(lang) },
  { name: _("nav.detained"), url: path },
];
const schema = graph([orgSchema(), breadcrumbSchema(crumbs)]);
---
<Base lang={lang} title={copy.title} description={copy.description} path={path} alternates={alternates} schema={schema}>
  <!-- No imagery, no eyebrow flourish, no sales language anywhere on this page. -->
  <section class="dhead wrap" data-surface="paper">
    <h1 class="h1" data-split-lines="hero">{copy.h1}</h1>
    <p class="lead">{copy.lead}</p>
    <p class="dhead-call">
      <a class="btn btn-primary" href={`tel:${ORG.phone.value}`}>{_("cta.callNow")} {ORG.phoneDisplay.value}</a>
    </p>
    <p class="apparatus">
      {es ? "Lunes a viernes" : "Monday to Friday"} · {ORG.hours.value.opens}&ndash;{ORG.hours.value.closes}
    </p>
  </section>

  <Section surface="paper">
    <div class="editorial">
      <div><p class="eyebrow">{copy.nowTitle}</p></div>
      <ol class="steps">{copy.now.map((s) => <li><p>{s}</p></li>)}</ol>
    </div>
  </Section>

  <Section surface="paper-2">
    <div class="editorial">
      <div><p class="eyebrow">{copy.haveTitle}</p></div>
      <ul class="plain">{copy.have.map((h) => <li>{h}</li>)}</ul>
    </div>
  </Section>

  <Section surface="paper">
    <div class="editorial">
      <div><p class="eyebrow">{copy.findTitle}</p></div>
      <div class="prose">
        <p>{copy.findBody}</p>
        <p><a class="link-arrow" href="https://locator.ice.gov/" rel="noopener">
          {es ? "Localizador de detenidos del gobierno" : "Government detainee locator"} <span aria-hidden="true">&rarr;</span>
        </a></p>
      </div>
    </div>
  </Section>

  <Section surface="navy">
    <div class="editorial">
      <div><p class="eyebrow">{copy.helpTitle}</p></div>
      <div>
        <ul class="plain">{copy.help.map((h) => <li>{h}</li>)}</ul>
        <p class="dcta"><a class="btn btn-primary" href={`tel:${ORG.phone.value}`}>{_("cta.callNow")}</a></p>
      </div>
    </div>
  </Section>

  <Section surface="paper">
    <div class="editorial">
      <div><p class="eyebrow">{copy.reachTitle}</p></div>
      <div class="prose">
        <address class="daddr">
          <a class="apparatus" href={`tel:${ORG.phone.value}`}>{ORG.phoneDisplay.value}</a>
          <a href={`mailto:${ORG.email.value}`}>{ORG.email.value}</a>
          <span>{ORG.address.value.street}, {ORG.address.value.locality}, {ORG.address.value.region} {ORG.address.value.postalCode}</span>
        </address>
        <p class="notice">{copy.courtNote}</p>
        <p class="notice">{_("disclaimer.general")}</p>
      </div>
    </div>
  </Section>
</Base>

<style>
  .dhead { padding-block: var(--spacing-s7) var(--spacing-s9); display: grid; gap: var(--spacing-s4); }
  .dhead-call { margin-top: var(--spacing-s2); }
  .plain { list-style: none; display: grid; gap: var(--spacing-s4); max-width: var(--container-m-read); }
  .plain > li { display: grid; grid-template-columns: 1.25rem 1fr; gap: var(--spacing-s3); font-size: var(--text-lead); }
  .plain > li::before { content: "\2014"; color: var(--surface-accent-ink); }
  [data-surface="navy"] .plain > li::before { color: var(--surface-accent); }
  .dcta { margin-top: var(--spacing-s7); }
  .daddr { display: grid; gap: var(--spacing-s2); font-style: normal; font-size: var(--text-lead); }
  .daddr a { color: var(--surface-ink); }
</style>
