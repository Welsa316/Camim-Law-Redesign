---
import Base from "../layouts/Base.astro";
import AccordionGallery from "./AccordionGallery.astro";
import type { GalleryItem } from "./AccordionGallery.astro";
import { t, langPath, type Lang } from "../i18n/ui";
import { ORG, ATTORNEY, MEDIA, show, mapEmbedUrl } from "../lib/org";
import { featured } from "../lib/services";
import { graph, orgSchema, attorneySchema } from "../lib/seo";
import { demoAllows } from "../lib/site.js";

/*
  Every visible string on this page is copied from camimlaw.com, from Campos
  Muños Law's site and dictionaries, or is a value from a checked record. The
  comment beside each names the source. Nothing was written for this page.
  verify/copy-provenance.py fails the build otherwise.
*/
interface Props { lang: Lang }
const { lang } = Astro.props;
const _ = t(lang);
const es = lang === "es";
const media = MEDIA.filter((m) => m.verified);
const rating = show(ORG.googleRating);
const heroImg = ATTORNEY.hero.value;
/* The sister firm's current headshot. The cafe photograph belongs to the
   attorney page — running it here too put the same seated frame twice on a
   two-page site, and the opening frame is already a chair. */
const portrait = ATTORNEY.headshot.value;
const address = ORG.address.value;
const directionsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${address.street}, ${address.locality}, ${address.region} ${address.postalCode}`)}`;

const src = es
  ? {
      // camimlaw.com home, "¿Qué hacemos?"
      display: "Representamos a inmigrantes",   // camimlaw.com home, "¿Qué hacemos?", fragment
      // camimlaw.com home, "¿Quiénes somos?", first sentence
      lead: "Campos Immigration Law está compuesto por abogados atentos y dedicados que practican exclusivamente la ley de inmigración en los Estados Unidos.",
      // camulaw.com home.reviewsTitle, fragment
      statReviews: "reseñas de cinco estrellas",
      // camimlaw.com home, "Áreas en las que prestamos servicios", fragment
      statStates: "estados de Estados Unidos",
      // camulaw.com team.members.juan.bio, fragment
      admitted: "Juan está admitido para ejercer la abogacía ante la Corte Suprema del Estado de Luisiana",
      // camimlaw.com home, fragments of "¿Por qué elegirnos?" / "¿Qué hacemos?"
      // The label has to be the question the section answers: the display line
      // and the note are both clauses of camimlaw.com's "¿Por qué elegirnos?"
      // paragraph, so labelling them "¿Quiénes somos?" put one section's
      // heading over another section's words.
      introLabel: "¿Por qué elegirnos?",
      introTitle: "Nos esforzaremos por tratarlo como familia.",
      introBody: "Queremos brindar soluciones a procesos y procedimientos que pueden ser desalentadores para que los inmigrantes naveguen por su cuenta.",
      introNote: "Nos aseguraremos de que comprenda lo que está sucediendo con su caso",
      // camulaw contact.title, fragment
      book: "Agende su consulta",
      // camimlaw.com home, "Áreas en las que prestamos servicios"
      where: "Nuestras oficinas están ubicadas en Orlando, sin embargo, atendemos a clientes en los 50 estados de Estados Unidos y en el extranjero.",
      title: "Campos Immigration Law",                        // camimlaw.com <title>
      description: "Campos Immigration Law está compuesto por abogados atentos y dedicados que practican exclusivamente la ley de inmigración en los Estados Unidos.",
    }
  : {
      display: "Hire an Experienced Immigration Lawyer",     // camimlaw.com services page
      lead: "We are here to help you. Virtual consultation available.", // camulaw contact.subtitle + home.virtualAvailable
      statReviews: "Five-Star Review",                       // camulaw home.reviewsTitle, fragment
      statStates: "states and abroad",                       // camulaw home.dondeEstamosText, fragment
      admitted: "Juan is admitted to practice law before the Louisiana Supreme Court", // camulaw bio, fragment
      introLabel: "Why Us?", // camulaw home.porQueNosotros
      introTitle: "We will strive to treat you like family.", // camulaw home.porQueNosotrosText, fragment
      // camulaw team.members.juan.bio, final sentence
      introBody: "As an immigrant himself, he understands his clients' concerns firsthand, and works to explain the complexities of immigration law in a way that's simple, clear, and easy to understand.",
      introNote: "We will make sure you understand what is happening with your case", // camulaw home.porQueNosotrosText, fragment
      book: "Schedule your consultation", // camulaw contact.title, fragment
      where: "We serve clients in all 50 states and abroad.", // camulaw home.dondeEstamosText, fragment (without the other firm's location)
      title: "Campos Immigration Law",
      description: "We are here to help you. Virtual consultation available.",
    };

/* Photographs are decorative here: the panel's own text is the link, so the
   image gets an empty alt and no written description (the copy rule). */
const serviceItems: GalleryItem[] = featured().map((s, i) => ({
  ordinal: String(i + 1).padStart(2, "0"),
  label: s.name[lang],
  meta: s.line[lang],
  link: demoAllows(s.slug) ? langPath(lang, s.slug) : "#servicios-acordeon",
  more: _("readMore"),
  ...(s.image
    ? { image: s.image.src, width: s.image.width, height: s.image.height, focus: s.image.focus, alt: "" }
    : {}),
}));

const altFor: Record<string, string> = {
  telemundo: _("press.alt.telemundo"),
  univision: _("press.alt.univision"),
  tvv: _("press.alt.tvv"),
};

const alternates = { es: "/", en: "/en/" };
const schema = graph([orgSchema(), attorneySchema(lang)]);
---
<Base lang={lang} title={src.title} description={src.description} path={es ? "/" : "/en/"} alternates={alternates} schema={schema} overHero landing>

  <section class="opener" data-surface="navy-deep" data-hero>
    <picture>
      <source media="(min-aspect-ratio: 1/1)" srcset={heroImg.wide.src} width={heroImg.wide.width} height={heroImg.wide.height} />
      <img
        class="opener-img"
        src={heroImg.tall.src}
        width={heroImg.tall.width}
        height={heroImg.tall.height}
        alt={`${ATTORNEY.displayName.value}, ${ATTORNEY.credentialSuffix.value}`}
        fetchpriority="high"
        decoding="async"
        data-scrub-portrait-img
      />
    </picture>
    <div class="opener-veil" aria-hidden="true"></div>

    <div class="opener-frame wrap-wide">
      <div class="opener-top">
        <ul class="opener-stats">
          {rating && (
            <li>
              <span class="stat-fig">{rating.value.toFixed(1)}</span>
              <span class="stat-label">{src.statReviews}</span>
            </li>
          )}
          <li>
            <span class="stat-fig">{ORG.statesServed.value}</span>
            <span class="stat-label">{src.statStates}</span>
          </li>
        </ul>
        <p class="opener-lead" data-reveal="text">{src.lead}</p>
      </div>

      <div class="opener-bottom">
        <h1 class="hero-type opener-display" data-split-lines="hero">{src.display}</h1>
        <div class="opener-side">
          <a class="opener-pill" href={demoAllows("consulta") ? langPath(lang, "consulta") : `tel:${ORG.phone.value}`} data-reveal="control">
            {_("cta.book")}<span class="opener-pill-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <div class="opener-rule" aria-hidden="true"></div>
          <p class="opener-meta apparatus" data-reveal="text">{src.admitted}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 — the introduction: the firm's own words beside the attorney -->
  <section class="home-intro" data-surface="paper-2" aria-labelledby="intro-title">
    <div class="wrap-wide intro-grid">
      <div class="intro-copy">
        <p class="chapter"><span class="chapter-number" aria-hidden="true">01</span>{src.introLabel}</p>
        <h2 class="home-title intro-title" id="intro-title" data-split-lines>{src.introTitle}</h2>
        <p class="intro-body" data-reveal="text">{src.introBody}</p>
        <p class="intro-note" data-reveal="text">{src.introNote}</p>
        {demoAllows("juan-campos")
          ? <a class="home-link intro-link" href={langPath(lang, "juan-campos")}>{_("nav.attorney")}<span class="home-link-arrow" aria-hidden="true">&rarr;</span></a>
          : <span class="home-link intro-link">{_("nav.attorney")}<span class="home-link-arrow" aria-hidden="true">&rarr;</span></span>}
      </div>
      <figure class="intro-portrait" data-reveal="portrait">
        <div class="intro-photo">
          <img src={portrait.src} width={portrait.width} height={portrait.height} alt={`${ATTORNEY.displayName.value}, ${ATTORNEY.credentialSuffix.value}`} loading="lazy" decoding="async" />
        </div>
        <figcaption class="intro-cap">
          <span class="portrait-name">{ATTORNEY.displayName.value}, {ATTORNEY.credentialSuffix.value}</span>
          <span class="portrait-firm">{ORG.name.value}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 02 — the four featured matters -->
  <section class="home-services" data-surface="paper" aria-labelledby="services-title">
    <div class="wrap-wide">
      <div class="section-heading">
        <div class="section-heading-title">
          <span class="chapter-number" aria-hidden="true">02</span>
          <h2 class="home-title" id="services-title" data-split-lines>{_("nav.services")}</h2>
        </div>
        {demoAllows("servicios")
          ? <a class="home-link" href={langPath(lang, "servicios")}>{_("nav.allServices")}<span class="home-link-arrow" aria-hidden="true">&rarr;</span></a>
          : <span class="home-link">{_("nav.allServices")}<span class="home-link-arrow" aria-hidden="true">&rarr;</span></span>}
      </div>
      <div class="scope-acc">
        <AccordionGallery items={serviceItems} id="servicios-acordeon" defaultIndex={0} height={460} expandRatio={0.5} tilt={2} />
      </div>
    </div>
  </section>

  <!-- 03 — broadcast appearances. The stills carry the description; the only
       words are the outlet, the station's own chyron and the programme. -->
  {media.length > 0 && (
    <section class="home-press" data-surface="paper-2" aria-labelledby="press-title">
      <div class="wrap-wide">
        <div class="section-heading">
          <div class="section-heading-title">
            <span class="chapter-number" aria-hidden="true">03</span>
            <h2 class="home-title" id="press-title" data-split-lines>{_("press.heading")}</h2>
          </div>
        </div>
        <ul class="press" data-stagger aria-label={_("press.aria")}>
          {media.map((m, i) => (
            <li class:list={["press-item", { "press-item--lead": i === 0 }]} data-reveal="media">
              <figure class="press-fig">
                <div class="press-still">
                  <img src={m.still} width={m.width} height={m.height} alt={altFor[m.id] ?? m.outlet} loading="lazy" decoding="async" />
                </div>
                <figcaption class="press-cap">
                  <span class="press-outlet">{m.outlet}</span>
                  <h3 class="press-chyron">{m.chyron[lang]}</h3>
                  <span class="press-prog apparatus">{m.station ? `${m.station} · ${m.programme}` : m.programme}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- 04 — the office. The city carries the section; the map supports it. -->
  <section class="home-office" data-surface="paper" aria-labelledby="office-title">
    <div class="wrap-wide office-grid">
      <div class="office-copy">
        <p class="chapter"><span class="chapter-number" aria-hidden="true">04</span>{_("home.where")}</p>
        <h2 class="office-city" id="office-title" data-split-lines>{address.locality}</h2>
        <p class="office-reach">{src.where}</p>
        <p class="office-virtual"><span class="office-virtual-mark" aria-hidden="true"></span>{_("contact.virtual")}</p>
      </div>
      <div class="office-details">
        <div class="office-block">
          <p class="detail-label">{_("contact.address")}</p>
          <address class="office-addr">
            <a class="office-directions" href={directionsUrl} target="_blank" rel="noopener noreferrer">{address.street}<span class="address-arrow" aria-hidden="true">&#8599;</span></a>
            <span>{address.locality}, {address.region} {address.postalCode}</span>
          </address>
        </div>
        <div class="office-info">
          <div class="office-block">
            <p class="detail-label">{_("contact.hours")}</p>
            <p>{_("contact.monFri")}</p>
            <p class="apparatus">{ORG.hours.value.opens}&ndash;{ORG.hours.value.closes}</p>
          </div>
          <div class="office-block">
            <p class="detail-label">{_("contact.contact")}</p>
            <a class="apparatus" href={`tel:${ORG.phone.value}`}>{ORG.phoneDisplay.value}</a>
            <a href={`mailto:${ORG.email.value}`}>{ORG.email.value}</a>
          </div>
        </div>
      </div>
      <iframe class="office-map" src={mapEmbedUrl()} title={_("home.where")} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    </div>
  </section>

  <!-- 05 — the closing invitation, flush against the footer's own navy -->
  <section class="statement" data-surface="navy-deep" aria-labelledby="consult-title">
    <div class="wrap-wide statement-inner">
      <div class="statement-copy">
        <p class="chapter statement-label">{_("nav.consultation")}</p>
        <h2 class="home-title statement-line" id="consult-title" data-split-lines>{_("home.questions")}</h2>
      </div>
      <div class="statement-action">
        <p class="statement-support">{_("contact.subtitle")}</p>
        <a class="opener-pill" href={demoAllows("consulta") ? langPath(lang, "consulta") : `tel:${ORG.phone.value}`}>{src.book}<span class="opener-pill-arrow" aria-hidden="true">&rarr;</span></a>
        <p class="statement-meta apparatus">{_("contact.confidential")}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* --- opening frame --- */
  .opener {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    /* The header is drawn over the frame, so the frame starts at the very top
       of the page and pads its own content back down past the bar. */
    margin-top: calc(var(--header-h) * -1);
    padding-top: var(--header-h);
    /* The fixed call bar sits over the last 76px of the viewport below 1024px. */
    min-height: calc(100svh - var(--mbar-h));
  }
  .opener-img {
    position: absolute; inset: 0; z-index: -2;
    width: 100%; height: 100%;
    object-fit: cover; object-position: 50% 22%;
    will-change: transform;
  }
  @media (min-aspect-ratio: 1/1) {
    .opener-img { object-position: 50% 0%; }
  }

  /* Four layers, each doing one job.
     1. A warm lift behind his head.
     2. A vertical wash: heavy under the bar and under the statement, light
        across the figure. The top of the wide frame is already dark in the
        asset, so the top stop can be gentler than it used to be.
     3. A horizontal wash on the margins, where the type corners sit and
        where the generated room is; the centre column is the photograph and
        is left alone.
     4. A bottom-left corner wash under the display line. */
  .opener-veil {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(34% 30% at 50% 24%, rgb(176 138 74 / 0.12) 0%, rgb(176 138 74 / 0) 100%),
      /* the four corners, where the type is; each is a local scrim that stops
         well short of the centre column, where he is */
      /* Reaches down to the figures now, not just to the top corner. Set as
         an element of its own behind them it read as a box with two hard
         edges; carried by the corner wash it is the same soft shape as the
         rest of the veil, and it is still under 0.1 where his face is. */
      radial-gradient(58% 62% at 0% 26%, rgb(11 31 51 / 0.84) 0%, rgb(11 31 51 / 0.52) 38%, rgb(11 31 51 / 0.18) 64%, rgb(11 31 51 / 0) 88%),
      radial-gradient(62% 50% at 100% 20%, rgb(11 31 51 / 0.94) 0%, rgb(11 31 51 / 0.80) 38%, rgb(11 31 51 / 0.46) 62%, rgb(11 31 51 / 0) 84%),
      radial-gradient(110% 80% at 6% 100%, rgb(11 31 51 / 0.86) 0%, rgb(11 31 51 / 0) 60%),
      radial-gradient(60% 50% at 100% 100%, rgb(11 31 51 / 0.60) 0%, rgb(11 31 51 / 0) 66%),
      linear-gradient(180deg,
        rgb(11 31 51 / 0.62) 0%,
        rgb(11 31 51 / 0.28) 9%,
        rgb(11 31 51 / 0.05) 16%,
        rgb(11 31 51 / 0.05) 60%,
        rgb(11 31 51 / 0.40) 74%,
        rgb(11 31 51 / 0.88) 88%,
        rgb(11 31 51 / 0.96) 100%),
      linear-gradient(90deg,
        rgb(11 31 51 / 0.66) 0%, rgb(11 31 51 / 0.32) 20%,
        rgb(11 31 51 / 0.00) 38%, rgb(11 31 51 / 0.00) 62%,
        rgb(11 31 51 / 0.40) 80%, rgb(11 31 51 / 0.70) 100%);
  }

  .opener-frame {
    position: relative;
    display: grid;
    /* Declared even though there is only ever one column: with no explicit
       column line, a `1 / -1` placement resolves to a zero-width track. */
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
    width: 100%;
    padding-block: var(--spacing-s7);
  }

  /* --- top row: figures left, sentence right --- */
  .opener-top { display: grid; gap: var(--spacing-s5); align-content: start; }

  .opener-stats {
    list-style: none;
    display: flex;
    gap: var(--spacing-s6);
    margin: 0; padding: 0;
  }
  .opener-stats li { display: grid; gap: 4px; }
  .opener-stats li + li {
    border-left: 1px solid rgb(252 252 250 / 0.24);
    padding-left: var(--spacing-s6);
  }
  .stat-fig {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    color: var(--color-paper);
  }
  /* Wrapped, not run on. "estados de Estados Unidos" set on one line reached
     39% of the frame, which is where the light grey of his suit begins, and
     the last word measured 1.03:1 against it. Two short lines keep the whole
     block inside the dark left third at every width. */
  .stat-label {
    max-width: 18ch; text-wrap: balance;
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #dbe3ea;
  }

  .opener-lead { color: #e6ecf2; max-width: 34ch; font-size: var(--text-base); margin: 0; }

  /* --- bottom row: statement left, action right --- */
  .opener-bottom { grid-row: 3; display: grid; gap: var(--spacing-s5); align-items: end; }
  .opener-display { margin: 0; max-width: 13ch; color: var(--color-paper); }

  .opener-side { display: grid; justify-items: start; gap: var(--spacing-s4); }
  .opener-pill {
    display: inline-flex; align-items: center; gap: var(--spacing-s3);
    min-height: 48px;
    padding: 0 var(--spacing-s5);
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-navy-deep);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-base);
    text-decoration: none;
    transition: background-color var(--d-state) var(--ease-state),
                color var(--d-state) var(--ease-state);
  }
  .opener-pill-arrow { transition: transform var(--d-state) var(--ease-state); }
  @media (any-hover: hover) {
    .opener-pill:hover { background: var(--color-brass-light); color: var(--color-navy-deep); }
    .opener-pill:hover .opener-pill-arrow { transform: translateX(3px); }
  }
  .opener-pill:focus-visible { outline: 2px solid var(--color-paper); outline-offset: 3px; }

  .opener-rule { height: 1px; width: 100%; background: rgb(252 252 250 / 0.3); }
  .opener-meta { color: #b6c3d1; margin: 0; }

  @media (max-width: 899px) {
    /* The phone frame is the tall crop, so he reads head to shoe and his face
       lands in the upper third. The whole apparatus therefore moves down and
       shares one dark ground with the statement, rather than sitting across
       the bright part of the frame. Measured, not assumed: in the top corner
       the figures' labels read 3.1:1 against the wall behind him, and
       darkening the veil enough to fix that put his face in shadow. */
    /* The floating language switch sits above the phone bar at the right,
       44px tall; the frame's last line has to end above it. */
    .opener-frame { grid-template-rows: 1fr auto auto; padding-block: var(--spacing-s6) calc(var(--spacing-s6) + 60px); }
    .opener-top { grid-row: 2; gap: var(--spacing-s4); }
    .opener-bottom { grid-row: 3; gap: var(--spacing-s4); }
    .opener-lead { display: none; }

    /* The scrim is anchored to the first row of type, not to a percentage of
       the frame. The type block is a fixed height while the frame is a
       viewport height, so the words begin at 42% of the frame on a 390x844
       phone and at 21% on a 320x720 one; no single set of gradient stops
       serves both, and chasing it with stops is what left the labels at
       1.4:1. It hangs off .opener-top as a pseudo-element rather than sitting
       in the grid as a row-spanning item, because placed in the grid it
       resolved to a zero-width track and rendered 40px wide. The stops are
       absolute lengths, so the dissolve is the same 150px everywhere. */
    .opener-top { position: relative; }
    .opener-top::after {
      content: "";
      position: absolute;
      left: calc(var(--gutter) * -1);
      right: calc(var(--gutter) * -1);
      top: -150px;
      bottom: -2400px;
      z-index: -1;
      background: linear-gradient(180deg,
        rgb(11 31 51 / 0) 0px,
        rgb(11 31 51 / 0.62) 96px,
        rgb(11 31 51 / 0.93) 150px,
        rgb(11 31 51 / 0.97) 300px,
        rgb(11 31 51 / 0.97) 100%);
    }
  }

  @media (min-width: 900px) {
    .opener-frame { padding-block: var(--spacing-s7) var(--spacing-s8); max-width: none; padding-inline: clamp(28px, 3.6vw, 84px); }
    /* The frame breaks out of the centred container and runs to the edges of
       the viewport. Two reasons, one compositional and one about him: type in
       the true corners is what makes a full-bleed frame read as cinematic
       rather than as a centred block on a photograph, and pushing the columns
       outward keeps the display line off his face. Inside the 1360px
       container at 1920 the headline crossed his eyes and mouth. */
    .opener-top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.78fr);
      align-items: start;
      gap: var(--spacing-s8);
      padding-top: var(--spacing-s6);
    }
    .opener-lead { justify-self: end; text-align: right; }
    .opener-bottom { grid-template-columns: minmax(0, 1.3fr) minmax(300px, 0.7fr); gap: var(--spacing-s9); }
    .opener-side { justify-items: end; text-align: right; }
    /* 4.8vw, not 5.6: the first line is the thirteen-letter "Representamos",
       and at 5.6vw its tail reached his shoulder at 1440. The frame's left
       third is the column; the word has to fit it. */
    .opener-display { font-size: clamp(2.4rem, 4.8vw, 6rem); line-height: 1.02; max-width: min(13ch, 32vw); }
  }
  /* The language switch floats at the bottom-left, 44px tall with a 16px
     margin, from 1024px up; the statement's last line has to end above it at
     every height. Measured: at the frame's own padding the serif's descender
     box reached the widget. Only the statement is lifted: the action column
     on the right stays low, in the heaviest part of the wash, because moving
     the whole row up put the small admitted line over the chair and cost it
     its contrast at 1280x800. */
  @media (min-width: 1024px) {
    .opener-display { margin-bottom: 56px; }
  }

  /* Landscape phones. The frame is shorter than the type wants to be, so the
     statement and the action sit either side of him rather than stacking
     through the middle, which is where they crossed his face. */
  @media (max-height: 560px) and (orientation: landscape) {
    .opener { min-height: auto; }
