---
import Base from "../layouts/Base.astro";
import Section from "./Section.astro";
import SituationFinder from "./SituationFinder.astro";
import ServiceRows from "./ServiceRows.astro";
import AccordionGallery from "./AccordionGallery.astro";
import type { GalleryItem } from "./AccordionGallery.astro";
import { t, langPath, type Lang } from "../i18n/ui";
import { ORG, ATTORNEY, MEDIA, COURT, show } from "../lib/org";
import { liveGroups } from "../lib/services";
import { graph, orgSchema, attorneySchema } from "../lib/seo";

interface Props { lang: Lang }
const { lang } = Astro.props;
const _ = t(lang);
const es = lang === "es";
const groups = liveGroups();
const admissions = show(ATTORNEY.admissions) ?? [];
const media = MEDIA.filter((m) => m.verified);
const rating = show(ORG.googleRating);
const consultation = show(ORG.consultation);
const portrait = ATTORNEY.portrait.value;
const heroImg = ATTORNEY.hero.value;
const seated = ATTORNEY.seated.value;
const atWork = show(ATTORNEY.atWork);

/* The gallery uses only real photographs of the attorney and real broadcast
   stills. There is no filler panel: if an image is not confirmed it is not in
   the set, and the gallery renders with however many are. */
const gallery: GalleryItem[] = [
  {
    image: seated.src, width: seated.width, height: seated.height,
    label: "Juan Campos, Esq.",
    meta: es ? "Abogado de inmigración" : "Immigration attorney",
    focus: "50% 18%",
    alt: es
      ? "Retrato de Juan Campos con saco de lino claro y corbatín."
      : "Portrait of Juan Campos in a light linen jacket and bow tie.",
  },
  ...(atWork
    ? [{
        image: atWork.src, width: atWork.width, height: atWork.height,
        label: es ? "En el escritorio" : "At the desk",
        meta: es ? "Explicaciones en español cada semana" : "Explanations in Spanish every week",
        focus: "62% 40%",
        alt: es
          ? "Juan Campos en su escritorio, explicando un tema de inmigración a cámara."
          : "Juan Campos at his desk, explaining an immigration topic to camera.",
      } as GalleryItem]
    : []),
  ...media
    .filter((m) => m.width >= 1000)
    .map((m) => ({
      image: m.still, width: m.width, height: m.height,
      label: m.outlet,
      meta: m.station ? `${m.station} · ${m.programme}` : m.programme,
      focus: "50% 22%",
      alt: es
        ? `Juan Campos entrevistado en ${m.outlet}.`
        : `Juan Campos interviewed on ${m.outlet}.`,
    } as GalleryItem)),
];

const copy = {
  es: {
    title: "Abogado de Inmigración en Orlando, FL | Campos Immigration Law",
    description:
      "Juan Campos, abogado dedicado exclusivamente a la ley de inmigración, con oficina en Orlando. Asilo y otros casos migratorios, explicados en español. (407) 418-9193.",
    display: "Inmigración es lo único que hacemos.",
    lead: "Juan Campos es abogado de inmigración. Le explicamos su caso en español, hasta que lo entienda, y usted siempre sabe qué sigue.",
    scopeEyebrow: "Lo que hacemos",
    scopeTitle: "Casos que llevamos",
    attorneyEyebrow: "El abogado",
    attorneyTitle: "Un abogado, con nombre y cara",
    attorneyBody: [
      "Nació en Coro, Venezuela. Fue profesor de derecho y abogado penalista antes de emigrar.",
      "Hizo una maestría en Derecho Comparado en la Universidad de Florida y encontró ahí el trabajo al que se dedica hoy. Trabajó como abogado de planta en Caridades Católicas de la Arquidiócesis de Nueva Orleans, representando a personas inmigrantes en algunos de los procesos más delicados del sistema.",
      "Hoy dedica su práctica por completo al derecho de inmigración, y publica cada semana explicaciones en español para que la gente entienda sus opciones antes de que sea tarde.",
    ],
    statement: "Usted no está hablando con un notario. Está hablando con un abogado.",
    statementMeta: "Juan Campos, Esq. · Admitido para ejercer en Louisiana Supreme Court · Miembro de AILA",
    commitmentsEyebrow: "Cómo trabajamos",
    commitments: [
      { t: "No aceptamos un caso que no podamos llevar.", d: "Si su asunto necesita otro tipo de abogado, se lo decimos en la consulta en vez de aceptarlo." },
      { t: "Le explicamos su caso hasta que lo entienda.", d: "En español, sin términos que no le hayamos explicado antes, y las veces que haga falta." },
      { t: "Usted siempre sabrá qué sigue y cuándo.", d: "Qué se presentó, qué falta, qué esperamos del gobierno y en qué plazo aproximado." },
    ],
    mediaEyebrow: "En los medios",
    mediaTitle: "El abogado, y dónde lo han entrevistado",
    mediaLead: "Todas las fotografías de este sitio son de él. No usamos imágenes de archivo de personas.",
    officeEyebrow: "La oficina",
    officeTitle: "Dónde estamos",
    officeBody:
      "La oficina está en Orlando. Como la inmigración es una materia federal, representamos también a personas que viven en otros estados y fuera del país.",
    courtNote: `La Corte de Inmigración de Orlando queda en ${COURT.address}.`,
    consultEyebrow: "La consulta",
    consultTitle: "Cómo funciona una consulta",
    consultSteps: [
      { t: "Nos escribe o nos llama", d: "Nos dice su nombre, cómo contactarle y de qué se trata. Todavía no hacen falta detalles." },
      { t: "Revisamos si podemos ayudarle", d: "Confirmamos que no haya conflicto de interés y que su caso sea de los que llevamos." },
      { t: "Hablamos de su caso", d: "Repasamos fechas, entradas y salidas, documentos y opciones reales. Sale sabiendo qué sigue." },
    ],
  },
  en: {
    title: "Orlando Immigration Lawyer | Campos Immigration Law",
    description:
      "Juan Campos practises United States immigration law exclusively, from an Orlando office, for clients in Florida and other states. Asylum and other matters. (407) 418-9193.",
    display: "Immigration law is all we do.",
    lead: "Juan Campos is an immigration attorney. We explain your case in your language, until it makes sense, and you always know what happens next.",
    scopeEyebrow: "What we do",
    scopeTitle: "Matters we handle",
    attorneyEyebrow: "The attorney",
    attorneyTitle: "A lawyer with a name and a face",
    attorneyBody: [
      "He was born in Coro, Venezuela. He was a law professor and a criminal defence lawyer before he emigrated.",
      "He took a master's in comparative law at the University of Florida and found there the work he does now. He served as a staff attorney at Catholic Charities of the Archdiocese of New Orleans, representing immigrants in some of the most sensitive proceedings in the system.",
      "Today his practice is entirely immigration law, and he publishes explanations in Spanish every week so that people understand their options before it is too late.",
    ],
    statement: "You are not talking to a notario. You are talking to a lawyer.",
    statementMeta: "Juan Campos, Esq. · Admitted to the Louisiana Supreme Court · Member of AILA",
    commitmentsEyebrow: "How we work",
    commitments: [
      { t: "We do not take a case we cannot carry.", d: "If your matter needs a different kind of lawyer, we say so at the consultation instead of taking it on." },
      { t: "We explain your case until it makes sense.", d: "In your language, with no term we have not defined first, as many times as it takes." },
      { t: "You will always know what happens next.", d: "What was filed, what is missing, what we expect from the government, and roughly when." },
    ],
    mediaEyebrow: "In the media",
    mediaTitle: "The attorney, and where he has been interviewed",
    mediaLead: "Every photograph on this site is of him. We use no stock imagery of people.",
    officeEyebrow: "The office",
    officeTitle: "Where we are",
    officeBody:
      "The office is in Orlando. Because immigration is federal law, we also represent people who live in other states and outside the country.",
    courtNote: `The Orlando Immigration Court is at ${COURT.address}.`,
    consultEyebrow: "The consultation",
    consultTitle: "How a consultation works",
    consultSteps: [
      { t: "You write or call", d: "Your name, how to reach you, and roughly what it is about. No details needed yet." },
      { t: "We check whether we can help", d: "We confirm there is no conflict of interest and that your matter is one we handle." },
      { t: "We go through your case", d: "Dates, entries and departures, documents and real options. You leave knowing what happens next." },
    ],
  },
}[lang];

const alternates = { es: "/", en: "/en/" };
const schema = graph([
  orgSchema(),
  attorneySchema(lang),
  { "@type": "WebPage", "@id": `${Astro.url.origin}${es ? "/" : "/en/"}#page`, name: copy.title, description: copy.description },
]);
---
<Base lang={lang} title={copy.title} description={copy.description} path={es ? "/" : "/en/"} alternates={alternates} schema={schema}>

  <!--
    01 / Opening frame — full bleed, type over image.

    The type frames the subject rather than sitting beside him or across him:
    apparatus top-left, the statement bottom-left, the actions bottom-right,
    and he holds the centre where the photograph puts him. That is the only
    arrangement that lets a front-facing centred portrait carry a cinematic
    hero without either covering his face or cropping his head.

    The vignette is heavier top and bottom, where the type is, and lightest
    across the middle band, where he is. Contrast under each text block is
    measured from real pixels, not assumed from an opacity.
  -->
  <section class="opener" data-surface="navy-deep">
    <picture>
      <source media="(min-aspect-ratio: 1/1)" srcset={heroImg.wide.src} width={heroImg.wide.width} height={heroImg.wide.height} />
      <img
        class="opener-img"
        src={heroImg.tall.src}
        width={heroImg.tall.width}
        height={heroImg.tall.height}
        alt={es
          ? "Juan Campos, abogado de inmigración, sentado en una silla de madera en la recepción de la oficina."
          : "Juan Campos, immigration attorney, seated in a wooden chair in the office reception."}
        fetchpriority="high"
        decoding="async"
        data-scrub-portrait-img
      />
    </picture>
    <div class="opener-veil" aria-hidden="true"></div>

    <div class="opener-frame wrap-wide">
      <div class="opener-top">
        <p class="eyebrow opener-eyebrow" data-reveal="text">
          <span class="eyebrow-full">{_("home.eyebrow")}</span>
          <span class="eyebrow-short">{es ? "Abogado de inmigración" : "Immigration attorney"}</span>
        </p>
        <p class="opener-note apparatus" data-reveal="text">
          {es
            ? "Admitido en Louisiana. La inmigración es federal, así que representamos a personas en Florida, en otros estados y fuera del país."
            : "Admitted in Louisiana. Immigration is federal, so we represent people in Florida, in other states and outside the country."}
        </p>
      </div>

      <div class="opener-bottom">
        <div class="opener-statement">
          <h1 class="hero-type opener-display" data-split-lines="hero">{copy.display}</h1>
        </div>
        <div class="opener-side">
          <p class="opener-lead" data-reveal="text">{copy.lead}</p>
          <div class="opener-actions" data-reveal="control">
            <a class="btn btn-primary" href={langPath(lang, es ? "consulta" : "consultation")}>{_("cta.book")}</a>
            <a class="btn btn-ghost opener-call" href={`tel:${ORG.phone.value}`}>
              {_("cta.call")} {ORG.phoneDisplay.value}
            </a>
          </div>
        </div>
      </div>

      <div class="opener-rule" aria-hidden="true"></div>
      <p class="opener-meta apparatus" data-reveal="text">
        Orlando, Florida &middot; {es ? "Español e inglés" : "Spanish and English"}
      </p>
    </div>
  </section>

  <!-- 02 / Situation finder -->
  <Section surface="paper-2">
    <SituationFinder lang={lang} />
  </Section>

  <!-- 03 / Practice groups -->
  <Section surface="paper">
    <div class="editorial">
      <div>
        <p class="eyebrow">{copy.scopeEyebrow}</p>
      </div>
      <div>
        <h2 class="h2" data-split-lines>{copy.scopeTitle}</h2>
      </div>
    </div>
    <div class="scope-rows">
      {groups.map((g, i) => <ServiceRows lang={lang} group={g} index={i + 1} />)}
    </div>
    <p class="scope-more">
      <a class="link-arrow" href={langPath(lang, es ? "servicios" : "services")}>
        {_("nav.allServices")} <span aria-hidden="true">&rarr;</span>
      </a>
    </p>
  </Section>

  <!-- 04 / The attorney. The one dark band on the page. -->
  <Section surface="navy">
    <div class="editorial">
      <div>
        <p class="eyebrow">{copy.attorneyEyebrow}</p>
      </div>
      <div class="att">
        <h2 class="h2" data-split-lines>{copy.attorneyTitle}</h2>
        <div class="prose att-body">
          {copy.attorneyBody.map((p) => <p>{p}</p>)}
        </div>

        <dl class="meta att-meta">
          <div class="meta-item">
            <dt class="meta-term">{es ? "Admisión" : "Admission"}</dt>
            <dd>{admissions.join(", ")}</dd>
          </div>
          <div class="meta-item">
            <dt class="meta-term">{es ? "Estudios" : "Education"}</dt>
            <dd>{(show(ATTORNEY.education) ?? []).map((e) => `${e.degree[lang]}, ${e.school}`).join(" · ")}</dd>
          </div>
          <div class="meta-item">
            <dt class="meta-term">{es ? "Membresía" : "Membership"}</dt>
            <dd>{(show(ATTORNEY.memberships) ?? []).join(", ")}</dd>
          </div>
          <div class="meta-item">
            <dt class="meta-term">{_("label.languages")}</dt>
            <dd>{es ? "Español e inglés" : "Spanish and English"}</dd>
          </div>
        </dl>

        <p class="att-cta">
          <a class="link-arrow" href={langPath(lang, "juan-campos")}>
            {_("cta.meetAttorney")} <span aria-hidden="true">&rarr;</span>
          </a>
        </p>
      </div>
    </div>
  </Section>

  <!--
    A single statement given a whole band. One line, display scale, on the
    institutional ground. It is the page's one rhetorical moment and it says
    something true and checkable rather than something performative.
  -->
  <section class="statement" data-surface="navy-deep">
    {/*
      A dark, near-abstract detail of flag fabric, heavily overlaid. It is a
      material and a texture, not a patriotic hero image: no waving flag, no
      seal, nothing implying a government connection. It carries the heritage
      palette and gives the page its one full-bleed moment.
    */}
    <img class="statement-bg" src="/img/flag-texture.jpg" width="1600" height="926"
         alt="" aria-hidden="true" loading="lazy" decoding="async" />
    <div class="wrap-wide statement-inner">
      <p class="hero-type statement-line" data-split-lines>{copy.statement}</p>
      <p class="apparatus statement-meta">{copy.statementMeta}</p>
    </div>
  </section>

  <!-- 06 / Commitments, as type. Not cards. -->
  <Section surface="paper">
    <div class="editorial">
      <div><p class="eyebrow">{copy.commitmentsEyebrow}</p></div>
      <ol class="commit" data-stagger>
        {copy.commitments.map((c, i) => (
          <li data-reveal="text">
            <span class="commit-n apparatus">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <p class="h2 commit-t">{c.t}</p>
              <p class="commit-d">{c.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  {gallery.length > 1 && (
    <Section surface="paper-2" wide>
      <div class="editorial gal-head">
        <div><p class="eyebrow">{copy.mediaEyebrow}</p></div>
        <div>
          <h2 class="h2" data-split-lines>{copy.mediaTitle}</h2>
          <p class="lead gal-lead">{copy.mediaLead}</p>
        </div>
      </div>
      <AccordionGallery items={gallery} id="galeria" defaultIndex={0} height={540} expandRatio={0.5} />
    </Section>
  )}

  <!-- 06 / Consultation, as a numbered column -->
  <Section surface="paper">
    <div class="editorial">
      <div><p class="eyebrow">{copy.consultEyebrow}</p></div>
      <div>
        <h2 class="h2" data-split-lines>{copy.consultTitle}</h2>
        <ol class="steps consult-steps">
          {copy.consultSteps.map((s) => (
            <li>
              <div>
                <p class="h4">{s.t}</p>
                <p class="consult-d">{s.d}</p>
              </div>
            </li>
          ))}
        </ol>
        {consultation ? (
          <p class="consult-price prose">{consultation.price}</p>
        ) : null}
        <p class="consult-cta">
          <a class="btn btn-primary" href={langPath(lang, es ? "consulta" : "consultation")}>{_("cta.book")}</a>
        </p>
      </div>
    </div>
  </Section>

  <!-- 07 / Office -->
  <Section surface="paper-2">
    <div class="editorial">
      <div><p class="eyebrow">{copy.officeEyebrow}</p></div>
      <div class="office">
        <h2 class="h2" data-split-lines>{copy.officeTitle}</h2>
        <p class="lead">{copy.officeBody}</p>
        <address class="office-addr">
          <span>{ORG.address.value.street}</span>
          <span>{ORG.address.value.locality}, {ORG.address.value.region} {ORG.address.value.postalCode}</span>
          <a class="apparatus" href={`tel:${ORG.phone.value}`}>{ORG.phoneDisplay.value}</a>
        </address>
        <p class="notice">{copy.courtNote}</p>
        {rating && (
          <p class="notice office-reviews">
            {es
              ? `Nuestros clientes nos han dejado ${rating.count} reseñas en Google, con una calificación de ${rating.value}.`
              : `Our clients have left ${rating.count} Google reviews, with a ${rating.value} rating.`}
          </p>
        )}
      </div>
    </div>
  </Section>
</Base>

<style>
  /* --- opening frame --- */
  .opener {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* The fixed call bar sits over the last 76px of the viewport below 1024px.
       Without subtracting it the frame's closing line lands underneath it. */
    min-height: calc(100svh - var(--header-h) - var(--mbar-h));
    display: grid;
  }
  .opener-img {
    position: absolute; inset: 0; z-index: -2;
    width: 100%; height: 100%;
    object-fit: cover; object-position: 50% 38%;
    will-change: transform;
  }

  /* Three layers, each doing one job.
     1. A vertical wash: heavy where the type is, lightest across the middle
        band, which is where his face is.
     2. A horizontal wash: darkens the left and right margins, which is where
        the corners of type sit, and leaves the centre column alone.
     3. A bottom-left corner wash under the display line, which is the largest
        block of type and the one sitting over the busiest part of the frame.
     The values are not guesses. They were set by measuring the composited
     pixels under each text block and raising each layer until the worst pixel
     in every block cleared its WCAG threshold. */
  .opener-veil {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(120% 85% at 8% 100%, rgb(11 31 51 / 0.82) 0%, rgb(11 31 51 / 0) 62%),
      linear-gradient(180deg,
        rgb(11 31 51 / 0.86) 0%,
        rgb(11 31 51 / 0.58) 14%,
        rgb(11 31 51 / 0.30) 36%,
        rgb(11 31 51 / 0.62) 62%,
        rgb(11 31 51 / 0.93) 82%,
        rgb(11 31 51 / 0.97) 100%),
      linear-gradient(90deg,
        rgb(11 31 51 / 0.72) 0%, rgb(11 31 51 / 0.22) 34%,
        rgb(11 31 51 / 0.18) 60%, rgb(11 31 51 / 0.62) 100%);
  }

  .opener-frame {
    position: relative;
    display: grid;
    /* Declared even though there is only ever one column: with no explicit
       column line, `grid-column: 1 / -1` on the scrim resolves to a zero-width
       track and the scrim silently renders 40px wide. */
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr auto auto auto;
    width: 100%;
    padding-block: var(--spacing-s7);
  }

  .opener-top { display: grid; gap: var(--spacing-s3); align-content: start; }
  .opener-eyebrow { color: var(--color-brass-light); margin: 0; }
  .eyebrow-short { display: none; }
  @media (max-width: 520px) { .eyebrow-full { display: none; } .eyebrow-short { display: inline; } }
  .opener-note { color: #c3cfdb; max-width: 46ch; margin: 0; }

  .opener-bottom { grid-row: 3; display: grid; gap: var(--spacing-s5); align-items: end; }
  .opener-display { margin: 0; max-width: 13ch; color: var(--color-paper); }
  .opener-lead { color: #dde4eb; max-width: 40ch; font-size: var(--text-base); margin: 0; }
  .opener-actions { display: flex; flex-wrap: wrap; gap: var(--spacing-s3); margin-top: var(--spacing-s4); }
  .opener-actions .btn { flex: 0 0 auto; }
  .opener-rule { grid-row: 4; height: 1px; background: rgb(252 252 250 / 0.3); margin-top: var(--spacing-s5); }
  .opener-meta { grid-row: 5; color: #b6c3d1; margin: var(--spacing-s3) 0 0; }

  .btn-ghost { background: transparent; color: var(--color-paper); border-color: rgb(252 252 250 / 0.5); }
  @media (any-hover: hover) {
    .btn-ghost:hover { background: rgb(252 252 250 / 0.14); border-color: var(--color-paper); }
  }

  @media (max-width: 899px) {
    /* The phone frame is the tall crop, so he reads head to shoe, and his face
       lands in the upper third. So the apparatus line moves down and joins the
       rest of the type in the lower band instead of sitting across the bright
       part of the frame. Measured, not assumed: at 390 and 430 the eyebrow in
       the top corner read 3.1:1 against the wall behind him, and darkening the
       veil enough to fix it would have put his face in shadow. Moving the type
       to where the scrim already is costs nothing and reads better — the image
       is clean at the top and every word sits over the same dark ground. */
    .opener-frame { grid-template-rows: 1fr auto auto auto auto; padding-block: var(--spacing-s6); }
    .opener-top { grid-row: 2; }
    .opener-bottom { grid-row: 3; gap: var(--spacing-s4); }
    .opener-rule { grid-row: 4; margin-top: var(--spacing-s4); }
    .opener-meta { grid-row: 5; }
    .opener-img { object-position: 50% 26%; }
    .opener-note { display: none; }
    .opener-call { display: none; }
    /* The floor in this photograph is pale polished concrete, so the bottom of
       the portrait crop is the brightest part of the frame — and it is exactly
       where the type now sits.

       The scrim for it is a grid item spanning from the first type row to the
       end, not a percentage stop in the veil. That distinction matters: the
       type block is a fixed height while the frame is a viewport height, so at
       390x844 the type starts at 42% of the frame and at 320x720 it starts at
       21%. A viewport-anchored gradient cannot serve both, and chasing it with
       stops is how the eyebrow ended up at 1.4:1. Anchored to the rows, the
       image dissolves into the ground exactly where the words begin, whatever
       the screen. */
    /* The scrim is anchored to the first row of type, not to a percentage of
       the viewport. That distinction is the whole fix: the type block is a
       fixed height while the frame is a viewport height, so the words begin at
       42% of the frame on a 390x844 phone and at 21% on a 320x720 one. No
       single set of gradient stops serves both, and chasing it with stops is
       what left the eyebrow at 1.4:1.

       It hangs off .opener-top as a pseudo-element rather than sitting in the
       grid as its own row-spanning item: placed in the grid it resolved to a
       zero-width track and rendered 40px wide, which is only the two negative
       margins with nothing between them. The stops are absolute lengths, so
       the dissolve is the same 150px everywhere and the ground below it is
       solid regardless of how tall the box ends up. */
    .opener-top { position: relative; }
    .opener-top::after {
      content: "";
      position: absolute;
      left: calc(var(--gutter) * -1);
      right: calc(var(--gutter) * -1);
      top: -150px;
      bottom: -2400px;
      z-index: -1;
      background: linear-gradient(180deg,
        rgb(11 31 51 / 0) 0px,
        rgb(11 31 51 / 0.62) 96px,
        rgb(11 31 51 / 0.93) 150px,
        rgb(11 31 51 / 0.97) 300px,
        rgb(11 31 51 / 0.97) 100%);
    }
  }

  /* Landscape phones. The frame is shorter than the type wants to be, so the
     headline was running underneath the fixed call bar. Sizing to content and
