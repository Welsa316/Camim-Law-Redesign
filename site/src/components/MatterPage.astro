---
import Base from "../layouts/Base.astro";
import Section from "./Section.astro";
import { t, langPath, type Lang } from "../i18n/ui";
import { ORG, ATTORNEY } from "../lib/org";
import { serviceBySlug, type Service } from "../lib/services";
import { graph, orgSchema, attorneySchema, breadcrumbSchema, serviceSchema } from "../lib/seo";

/* Every string here is a sourced block from services.ts, a dictionary label,
   or a record value. See services.ts for provenance and the omission log. */
interface Props { lang: Lang; service: Service }
const { lang, service } = Astro.props;
const _ = t(lang);
const es = lang === "es";
const path = langPath(lang, service.slug);
const related = service.related.map(serviceBySlug).filter((s): s is Service => !!s);
const admitted = es
  ? "Juan está admitido para ejercer la abogacía ante la Corte Suprema del Estado de Luisiana" // camulaw bio, fragment
  : "Juan is admitted to practice law before the Louisiana Supreme Court";
const alternates = { es: langPath("es", service.slug), en: langPath("en", service.slug) };
const crumbs = [
  { name: _("nav.home"), url: langPath(lang) },
  { name: _("nav.services"), url: langPath(lang, "servicios") },
  { name: service.name[lang], url: path },
];
const schema = graph([orgSchema(), attorneySchema(lang), breadcrumbSchema(crumbs), serviceSchema(service.name[lang], path, lang, service.line[lang])]);
---
<Base lang={lang} title={`${service.name[lang]} — ${ORG.name.value}`} description={service.line[lang]} path={path} alternates={alternates} schema={schema}>

  <nav class="crumbs wrap">
    <ol>
      {crumbs.map((c, i) => (
        <li>{i < crumbs.length - 1 ? <a href={c.url}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
      ))}
    </ol>
  </nav>

  <section class="mhead wrap" data-surface="paper">
    <p class="eyebrow">{_("nav.services")}</p>
    <h1 class="h1 mhead-title">{service.name[lang]}</h1>
    <p class="lead mhead-summary">{service.line[lang]}</p>
    <div class="mhead-actions">
      <a class="btn btn-primary" href={langPath(lang, "consulta")}>{_("cta.book")}</a>
      <a class="btn btn-secondary" href={`tel:${ORG.phone.value}`}>{_("cta.call")} {ORG.phoneDisplay.value}</a>
    </div>
    <p class="apparatus mhead-by">{ATTORNEY.displayName.value}, {ATTORNEY.credentialSuffix.value} &middot; {admitted}</p>
  </section>

  <Section surface="paper">
    <div class="editorial">
      <div></div>
      <div class="prose blocks">
        {service.blocks[lang].map((b) =>
          b.type === "heading" ? <h2 class="h2" data-split-lines>{b.text}</h2>
          : b.type === "subheading" ? <h3 class="h3">{b.text}</h3>
          : b.type === "list" ? <ul>{b.items.map((i) => <li>{i}</li>)}</ul>
          : <p>{b.text}</p>
        )}
      </div>
    </div>
  </Section>

  <Section surface="paper-2">
    <div class="editorial">
      <div><p class="eyebrow">{_("home.questions")}</p></div>
      <div class="next">
        <p class="lead">{_("contact.subtitle")}</p>
        <div class="mhead-actions">
          <a class="btn btn-primary" href={langPath(lang, "consulta")}>{_("cta.book")}</a>
          <a class="btn btn-secondary" href={`tel:${ORG.phone.value}`}>{_("cta.call")} {ORG.phoneDisplay.value}</a>
        </div>
        {related.length > 0 && (
          <div class="rel">
            <p class="eyebrow">{_("services.related")}</p>
            <p class="dim">{_("services.relatedSub")}</p>
            <ul class="rows">
              {related.map((r) => (
                <li class="row-item">
                  <a class="row-link" href={langPath(lang, r.slug)}>
                    <span class="row-title">{r.name[lang]}</span>
                    <span class="row-arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </Section>
</Base>

<style>
  .blocks h2 { margin-top: var(--spacing-s7); }
  .blocks h2:first-child { margin-top: 0; }
  .blocks h3 { margin-top: var(--spacing-s5); }

  /* Only ever visible in a review build. Deliberately loud. */
  .reviewbar {
    background: #3a2a12; color: #fdf6e8;
    padding: var(--spacing-s4) var(--gutter);
    font-size: var(--text-sm);
  }
  .reviewbar p { max-width: var(--container-content); margin-inline: auto; }
  .reviewbar strong { color: #ffd79a; }

  @media (any-hover: hover) { .crumbs a:hover { color: var(--color-accent-ink); } }

  .mhead { padding-block: var(--spacing-s6) var(--spacing-s9); display: grid; gap: var(--spacing-s5); }
  .mhead-title { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--spacing-s4); }
  .mhead-form { font-family: var(--font-mono); font-size: var(--text-h4);
                letter-spacing: 0.04em; font-variant-numeric: tabular-nums; color: var(--color-accent-ink); }
  .mhead-summary { max-width: var(--container-m-read); }
  .mhead-actions { display: flex; flex-wrap: wrap; gap: var(--spacing-s3); }
  .mhead-by { color: var(--color-ink-2); }

  .who { list-style: none; display: grid; gap: var(--spacing-s4); max-width: var(--container-m-read); }
  .who > li { display: grid; grid-template-columns: 1.25rem 1fr; gap: var(--spacing-s3); font-size: var(--text-lead); }
  .who > li::before { content: "\2014"; color: var(--surface-accent-ink); }

  .mstep { max-width: var(--container-m-read); }
  .help { list-style: none; display: grid; gap: var(--spacing-s4); max-width: var(--container-m-read); }
  .help > li { display: grid; grid-template-columns: 1.25rem 1fr; gap: var(--spacing-s3); }
  .help > li::before { content: "\2014"; color: var(--surface-accent); }
  .help-cta { margin-top: var(--spacing-s7); }

  .faqs { max-width: var(--container-m-read); border-bottom: 1px solid var(--surface-line); }
  .next { display: grid; gap: var(--spacing-s5); }
  .rel { margin-top: var(--spacing-s5); display: grid; gap: var(--spacing-s3); }
  .next-note { margin-top: var(--spacing-s5); }
</style>
