---
import { t, langPath, type Lang } from "../i18n/ui";
import { ORG, show } from "../lib/org";

interface Props { lang: Lang; otherHref?: string }
const { lang, otherHref } = Astro.props;
const other: Lang = lang === "es" ? "en" : "es";
const _ = t(lang);
const whatsapp = show(ORG.whatsapp);
---
<!--
  The single most valuable action on this site is "call this office", and it has
  to be one thumb-reach away at every scroll position. A persistent designed bar
  rather than a floating bubble that covers content.
-->
<div class="mbar" data-mobile-bar>
  <a class="mbar-btn mbar-btn--primary" href={`tel:${ORG.phone.value}`}>
    {_("cta.call")}
    <span class="mbar-num apparatus">{ORG.phoneDisplay.value}</span>
  </a>
  {whatsapp ? (
    <a class="mbar-btn mbar-btn--wa" href={whatsapp} rel="noopener">
      {/* The WhatsApp glyph, as published in WhatsApp's brand resources. */}
      <svg class="mbar-wa" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2m0 18.15c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 4.54 0 8.24 3.7 8.24 8.24 0 4.54-3.7 8.24-8.23 8.24m4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18l-.47-.21"/>
      </svg>
      <span>WhatsApp</span><span class="sr-only"> · {_("cta.whatsapp")}</span>
    </a>
  ) : (
    <a class="mbar-btn" href={langPath(lang, "consulta")}>{_("cta.book")}</a>
  )}
  {otherHref && (
    <a class="mbar-btn mbar-btn--lang" href={otherHref} lang={other} hreflang={other} aria-label={other === "en" ? _("lang.en") : _("lang.es")}>
      <img class="mbar-flag" src={other === "en" ? "/img/flags/us.svg" : "/img/flags/mx.svg"} width="20" height="15" alt="" aria-hidden="true" decoding="async" />
      <span aria-hidden="true">{other === "en" ? "EN" : "ES"}</span>
    </a>
  )}
</div>

<style>
  .mbar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 90;
    display: grid; grid-template-columns: 1.5fr 1fr 0.72fr;
    gap: 1px; background: var(--color-line-strong);
    border-top: 1px solid var(--color-line-strong);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .mbar-btn {
    display: grid; place-items: center; gap: 2px;
    min-height: 56px; padding: var(--spacing-s2);
    background: var(--color-paper); color: var(--color-ink);
    text-decoration: none; font-weight: var(--font-weight-semibold);
  }
  .mbar-btn--primary { background: var(--color-navy); color: var(--color-paper); }
  .mbar-btn--wa { grid-auto-flow: column; gap: var(--spacing-s2); color: var(--color-ink); }
  .mbar-wa { color: #25d366; flex: none; }
  .mbar-btn--lang { grid-auto-flow: column; gap: 8px; font-family: var(--font-mono); letter-spacing: 0.08em; }
  /* At 320 the middle cell is under 100px: the glyph plus the word do not fit,
     and the glyph was being pushed out of the button. Below 360 the glyph
     carries it; the name stays for assistive technology. */
  @media (max-width: 359px) { .mbar-btn--wa > span:not(.sr-only) { display: none; } }
  .mbar-flag { width: 20px; height: 15px; border-radius: 2px; box-shadow: 0 0 0 1px rgb(37 40 43 / 0.15); }
  .mbar-num { font-size: var(--text-eyebrow); color: inherit; opacity: 0.85; }
  .mbar-btn:active { filter: brightness(0.94); }
  /* The bar covers the last strip of the page, so the page reserves room. */
  :global(body) { padding-bottom: var(--mbar-h); }
  @media (min-width: 1024px) {
    .mbar { display: none; }
    :global(body) { padding-bottom: 0; }
  }
</style>
