---
import Base from "../layouts/Base.astro";
import TileIcon from "./TileIcon.astro";
import { t, langPath, type Lang } from "../i18n/ui";
import { ORG, show } from "../lib/org";
import { graph, orgSchema, breadcrumbSchema } from "../lib/seo";
import { demoAllows } from "../lib/site.js";

/* camimlaw.com "Hacer un pago"; camulaw.com payment.subtitle / contactMessage;
   the LawPay link is a record. The same three-tile composition as the
   consultation page: the firm's existing LawPay page first, as the primary
   tile, then the office by phone or WhatsApp, with the sister site's own line
   about arranging payment with the office under them. */
interface Props { lang: Lang }
const { lang } = Astro.props;
const _ = t(lang);
const whatsapp = show(ORG.whatsapp);
const path = langPath(lang, "pagos");
const alternates = { es: "/pagos/", en: "/en/pagos/" };
const crumbs = [{ name: _("nav.home"), url: langPath(lang) }, { name: _("nav.payment"), url: path }];
const schema = graph([orgSchema(), breadcrumbSchema(crumbs)]);
const addr = ORG.address.value;
// The English title is the sister site's question ("Want to make a payment?"),
// which reads badly on a tile; the navigation's "Payment" is used there.
const payLabel = lang === "es" ? _("payment.title") : _("nav.payment");
---
<Base lang={lang} title={`${_("payment.title")} — ${ORG.name.value}`} description={_("payment.subtitle")} path={path} alternates={alternates} schema={schema}>

  <nav class="crumbs wrap-wide">
    <ol>
      <li>{demoAllows("") ? <a href={langPath(lang)}>{_("nav.home")}</a> : <span>{_("nav.home")}</span>}</li>
      <li><span aria-current="page">{_("nav.payment")}</span></li>
    </ol>
  </nav>

  <section class="phead wrap-wide" data-surface="paper">
    <h1 class="h1 phead-title" data-split-lines="hero">{_("payment.title")}</h1>
    <p class="lead">{_("payment.subtitle")}</p>
  </section>

  <section class="wrap-wide tiles" aria-label={_("payment.subtitle")}>
    <a class="tile tile--primary" href={ORG.paymentUrl.value} rel="noopener">
      <TileIcon name="card" />
      <span class="tile-label">{payLabel} <span aria-hidden="true">&#8599;</span></span>
      <span class="tile-meta apparatus">{ORG.paymentProvider.value}</span>
    </a>
    <a class="tile" href={`tel:${ORG.phone.value}`}>
      <TileIcon name="phone" />
      <span class="tile-label">{_("cta.call")}</span>
      <span class="tile-meta apparatus">{ORG.phoneDisplay.value}</span>
    </a>
    {whatsapp && (
      <a class="tile" href={whatsapp} rel="noopener">
        <TileIcon name="whatsapp" />
        <span class="tile-label">{_("cta.whatsapp")}</span>
        <span class="tile-meta apparatus">WhatsApp</span>
      </a>
    )}
  </section>

  <section class="wrap-wide pnote">
    <p class="pnote-body">{_("payment.body")}</p>
    <p class="office apparatus">{addr.street} <span aria-hidden="true">&middot;</span> {addr.locality}, {addr.region} <span aria-hidden="true">&middot;</span> {_("contact.monFri")} {ORG.hours.value.opens}&ndash;{ORG.hours.value.closes}</p>
  </section>
</Base>

<style>
  /* One left edge with the logo, as on every other inner page. */
  .phead { padding-block: var(--spacing-s6) 0; display: grid; gap: var(--spacing-s4); justify-items: start; }
  .phead p { margin: 0; }
  .phead-title { margin: 0; max-width: 16ch; }

  .pnote { display: grid; gap: var(--spacing-s4); padding-block: var(--spacing-s2) clamp(72px, 7vw, 128px); }
  .pnote-body { margin: 0; max-width: 34em; padding-left: var(--spacing-s4); border-left: 2px solid var(--surface-line-strong); }
  .office { margin: 0; color: var(--color-ink-2); }
  .office span { margin-inline: var(--spacing-s1); }
</style>
