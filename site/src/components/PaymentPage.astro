---
import Base from "../layouts/Base.astro";
import Section from "./Section.astro";
import { t, langPath, type Lang } from "../i18n/ui";
import { ORG } from "../lib/org";
import { graph, orgSchema, breadcrumbSchema } from "../lib/seo";

/* camimlaw.com "Hacer un pago"; camulaw.com payment.subtitle / contactMessage; the LawPay link is a record. */
interface Props { lang: Lang }
const { lang } = Astro.props;
const _ = t(lang);
const path = langPath(lang, "pagos");
const alternates = { es: "/pagos/", en: "/en/pagos/" };
const crumbs = [{ name: _("nav.home"), url: langPath(lang) }, { name: _("nav.payment"), url: path }];
const schema = graph([orgSchema(), breadcrumbSchema(crumbs)]);
---
<Base lang={lang} title={`${_("payment.title")} — ${ORG.name.value}`} description={_("payment.subtitle")} path={path} alternates={alternates} schema={schema}>
  <section class="head wrap" data-surface="paper">
    <p class="eyebrow">{_("nav.payment")}</p>
    <h1 class="h1" data-split-lines="hero">{_("payment.title")}</h1>
    <p class="lead">{_("payment.subtitle")}</p>
  </section>
  <Section surface="paper-2">
    <div class="editorial">
      <div></div>
      <div class="prose">
        <p>{_("payment.body")}</p>
        <p><a class="btn btn-primary" href={ORG.paymentUrl.value} rel="noopener">{_("payment.title")}</a></p>
        <p><a class="link-arrow" href={`tel:${ORG.phone.value}`}>{_("cta.call")} {ORG.phoneDisplay.value} <span aria-hidden="true">&rarr;</span></a></p>
      </div>
    </div>
  </Section>
</Base>

<style>
  .head { padding-block: var(--spacing-s8) var(--spacing-s9); display: grid; gap: var(--spacing-s4); }
  .pays { display: grid; gap: var(--spacing-s8); }
  @media (min-width: 760px) { .pays { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--spacing-s10); } }
  .pay { display: grid; gap: var(--spacing-s4); justify-items: start; align-content: start; }
  .dim { color: var(--surface-ink-2); max-width: var(--container-m-short); }
  .pay-h { margin-top: var(--spacing-s6); }
</style>
