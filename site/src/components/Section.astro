---
interface Props {
  surface?: "paper" | "paper-2" | "navy" | "navy-deep";
  id?: string;
  wide?: boolean;
  class?: string;
}
const { surface = "paper", id, wide = false, class: cls = "" } = Astro.props;
---
<section class:list={["section", cls]} data-surface={surface} id={id}>
  <div class={wide ? "wrap-wide" : "wrap"}>
    <slot />
  </div>
</section>
