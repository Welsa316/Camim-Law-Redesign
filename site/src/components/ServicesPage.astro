---
import Base from "../layouts/Base.astro";
import ClosingStatement from "./ClosingStatement.astro";
import { t, langPath, type Lang } from "../i18n/ui";
import { ORG } from "../lib/org";
import { SERVICES } from "../lib/services";
import { graph, orgSchema, breadcrumbSchema } from "../lib/seo";
import { demoAllows } from "../lib/site.js";

/* The fourteen practice areas, each with its own summary line, which is what
   lets a reader tell from here whether a page is about their situation. No
   introduction: nothing on either firm's site introduces this list truthfully
   (the sister site's line promises a video on most pages, and there are none
   yet), and this site does not write its own. */
interface Props { lang: Lang }
const { lang } = Astro.props;
const _ = t(lang);
const path = langPath(lang, "servicios");
const alternates = { es: "/servicios/", en: "/en/servicios/" };
const crumbs = [{ name: _("nav.home"), url: langPath(lang) }, { name: _("nav.services"), url: path }];
const schema = graph([orgSchema(), breadcrumbSchema(crumbs)]);
---
<Base lang={lang} title={`${_("nav.services")} — ${ORG.name.value}`} description={SERVICES.map((s) => s.name[lang]).join(" · ")} path={path} alternates={alternates} schema={schema} landing>

  <nav class="crumbs wrap-wide">
    <ol>
      <li>{demoAllows("") ? <a href={langPath(lang)}>{_("nav.home")}</a> : <span>{_("nav.home")}</span>}</li>
      <li><span aria-current="page">{_("nav.services")}</span></li>
    </ol>
  </nav>

  <section class="shead wrap-wide" data-surface="paper">
    <h1 class="h1" data-split-lines="hero">{_("nav.services")}</h1>
  </section>

  <section class="section sbody" data-surface="paper">
    <div class="wrap-wide">
      <ul class="rows svc">
        {SERVICES.map((m) => (
          <li class="row-item">
            {demoAllows(m.slug) ? (
              <a class="row-link" href={langPath(lang, m.slug)}>
                <span class="row-title">{m.name[lang]}</span>
                <span class="row-arrow" aria-hidden="true">&rarr;</span>
                <span class="row-line">{m.line[lang]}</span>
              </a>
            ) : (
              <span class="row-link">
                <span class="row-title">{m.name[lang]}</span>
                <span class="row-line">{m.line[lang]}</span>
              </span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ClosingStatement lang={lang} />
</Base>

<style>
  /* One left edge with the logo, as on the practice pages and the attorney page. */
  .shead { padding-block: var(--spacing-s6) 0; }
  .sbody { padding-block: clamp(44px, 4.4vw, 72px) clamp(64px, 6vw, 112px); }
  .svc { max-width: 48rem; }

  /* On a desktop the fourteen sit in two ruled columns, so the whole list is
     in view at once and a summary line is short enough to read at a glance. */
  @media (min-width: 1024px) {
    .svc {
      max-width: none; border-top: 0;
      display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--spacing-s8);
    }
    .svc .row-item:nth-child(-n + 2) { border-top: 1px solid var(--surface-line); }
  }
</style>
