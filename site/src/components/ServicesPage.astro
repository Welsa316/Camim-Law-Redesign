---
import Base from "../layouts/Base.astro";
import Section from "./Section.astro";
import { t, langPath, type Lang } from "../i18n/ui";
import { ORG } from "../lib/org";
import { SERVICES } from "../lib/services";
import { graph, orgSchema, breadcrumbSchema } from "../lib/seo";

interface Props { lang: Lang }
const { lang } = Astro.props;
const _ = t(lang);
const path = langPath(lang, "servicios");
const alternates = { es: "/servicios/", en: "/en/servicios/" };
const crumbs = [{ name: _("nav.home"), url: langPath(lang) }, { name: _("nav.services"), url: path }];
const schema = graph([orgSchema(), breadcrumbSchema(crumbs)]);
---
<Base lang={lang} title={`${_("nav.services")} — ${ORG.name.value}`} description={_("nav.services")} path={path} alternates={alternates} schema={schema}>
  <section class="head wrap" data-surface="paper">
    <h1 class="h1" data-split-lines="hero">{_("nav.services")}</h1>
  </section>

  <Section surface="paper">
    <div class="editorial">
      <div></div>
    <ul class="svc rows">
      {SERVICES.map((m) => (
        <li class="row-item">
          <a class="row-link svc-link" href={langPath(lang, m.slug)}>
            <span class="row-title svc-title">{m.name[lang]}</span>
            <span class="svc-line">{m.line[lang]}</span>
            <span class="row-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))}
    </ul>
    </div>
  </Section>
</Base>

<style>
  .svc { list-style: none; margin: 0; padding: 0; max-width: var(--container-m-lead, 72ch); }
  .svc-link { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto auto; column-gap: var(--spacing-s4); row-gap: 4px; align-items: start; }
  .svc-title { grid-column: 1; }
  .svc-line { grid-column: 1; color: var(--color-ink-2); font-size: var(--text-base); line-height: 1.5; }
  .svc-link .row-arrow { grid-column: 2; grid-row: 1 / span 2; align-self: center; }

  .head { padding-block: var(--spacing-s8) var(--spacing-s9); display: grid; gap: var(--spacing-s4); }
  .az { list-style: none; display: grid; gap: var(--spacing-s3); margin-top: var(--spacing-s5); }
  @media (min-width: 700px) { .az { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--spacing-s8); } }
  .az a { display: inline-flex; align-items: center; min-height: 44px;
          color: var(--surface-ink); text-decoration: none; }
  @media (any-hover: hover) { .az a:hover { color: var(--surface-accent-ink); text-decoration: underline; text-underline-offset: 0.2em; } }
</style>
