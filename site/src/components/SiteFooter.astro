---
import { t, langPath, type Lang } from "../i18n/ui";
import { ORG, ATTORNEY } from "../lib/org";
import { demoAllows } from "../lib/site.js";

interface Props {
  lang: Lang;
  /**
   * The page above ends on the navy closing band, so the footer runs straight
   * on from it rather than opening with a band of paper between two dark
   * blocks. Layout only: every page carries the same footer content.
   */
  flush?: boolean;
}
const { lang, flush = false } = Astro.props;
const _ = t(lang);
const a = ORG.address.value;

/* Same lockup as the header, one rank larger: the firm signs the page. */
const links = [
  { slug: "servicios", label: _("nav.services") },
  { slug: "juan-campos", label: _("nav.attorney") },
  { slug: "consulta", label: _("nav.consultation") },
  { slug: "pagos", label: _("nav.payment") },
].map((l) => ({ ...l, href: langPath(lang, l.slug) }));
const social = [
  { href: ORG.social.value.instagram, label: "Instagram" },
  { href: ORG.social.value.facebook, label: "Facebook" },
  { href: ORG.social.value.youtube, label: "YouTube" },
  { href: ORG.social.value.tiktok, label: "TikTok" },
];
---
<footer class="ftr" data-surface="navy-deep" data-flush={flush ? "" : undefined}>
  <div class="ftr-inner wrap-wide">
    <div class="ftr-top">
      {demoAllows()
        ? <a class="ftr-mark" href={langPath(lang)}><span class="ftr-mark-name">Campos</span><span class="ftr-mark-rest">Immigration Law</span></a>
        : <span class="ftr-mark"><span class="ftr-mark-name">Campos</span><span class="ftr-mark-rest">Immigration Law</span></span>}
      <ul class="ftr-links">
        {links.map((l) => (
          <li>{demoAllows(l.slug) ? <a class="ftr-link" href={l.href}>{l.label}</a> : <span class="ftr-link">{l.label}</span>}</li>
        ))}
      </ul>
    </div>

    {/* camimlaw.com's own footer headings: Ubicación, Horario, Contactanos. */}
    <div class="ftr-grid">
      <div class="ftr-col">
        <p class="ftr-h">{_("contact.address")}</p>
        <address class="ftr-addr">
          <span>{a.street}</span>
          <span>{a.locality}, {a.region} {a.postalCode}</span>
        </address>
      </div>
      <div class="ftr-col">
        <p class="ftr-h">{_("contact.hours")}</p>
        <p>{_("contact.monFri")}</p>
        <p class="apparatus">{ORG.hours.value.opens}&ndash;{ORG.hours.value.closes}</p>
      </div>
      <div class="ftr-col">
        <p class="ftr-h">{_("contact.contact")}</p>
        <a class="apparatus" href={`tel:${ORG.phone.value}`}>{ORG.phoneDisplay.value}</a>
        <a href={`mailto:${ORG.email.value}`}>{ORG.email.value}</a>
      </div>
      <div class="ftr-col">
        <p class="ftr-h">{_("contact.connect")}</p>
        <ul class="ftr-social">
          {social.map((sx) => <li><a href={sx.href} rel="noopener">{sx.label}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="ftr-legal">
      <p class="ftr-firm">{ORG.legalName.value} &middot; {ATTORNEY.displayName.value}, {ATTORNEY.credentialSuffix.value}</p>
      {/* camulaw.com, team.members.juan.bio: the admission sentence. Rule 4-7.21(d). */}
      <p class="ftr-note">
        {lang === "es"
          ? "Juan está admitido para ejercer la abogacía ante la Corte Suprema del Estado de Luisiana y es miembro de la American Immigration Lawyers Association (AILA)."
          : "Juan is admitted to practice law before the Louisiana Supreme Court and is a member of the American Immigration Lawyers Association (AILA)."}
      </p>
    </div>
  </div>
</footer>

<style>
  /* The footer used to open with a band of paper above it — `margin-top` on a
     navy block — which on the home page put a stripe of a third colour
     between the closing navy band and the navy footer. The separation is the
     footer's own padding now, so the two dark blocks meet. */
  .ftr { padding-block: var(--spacing-s10) var(--spacing-s8); }
  .ftr[data-flush] { padding-top: var(--spacing-s8); }
  .ftr-inner { display: grid; gap: var(--spacing-s7); }

  /* --- the signature ------------------------------------------------------ */
  .ftr-top {
    display: flex; flex-wrap: wrap; align-items: baseline;
    justify-content: space-between; gap: var(--spacing-s5) var(--spacing-s8);
    padding-bottom: var(--spacing-s6);
    border-bottom: 1px solid var(--surface-line);
  }
  /* The header's lockup, one rank up. Grid rather than flex so the descriptor
     sits under the name rather than beside it at any width. */
  .ftr-mark {
    display: grid; grid-template-columns: minmax(0, 1fr);
    row-gap: 6px; min-width: 0;
    text-decoration: none; color: var(--surface-ink);
  }
  .ftr-mark-name {
    font-family: var(--font-serif); font-weight: 400;
    font-size: clamp(30px, 22px + 1.4vw, 44px); line-height: 1; letter-spacing: -0.025em;
  }
  .ftr-mark-rest {
    font-family: var(--font-mono); font-size: var(--text-eyebrow);
    letter-spacing: 0.22em; text-transform: uppercase; color: var(--surface-ink-2);
  }
  .ftr-links {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: var(--spacing-s2) var(--spacing-s6);
  }
  .ftr-link { font-size: var(--text-base); }

  /* --- the practical columns ---------------------------------------------- */
  /* `max-content` rather than `1fr`: two columns on the landing page and four
     elsewhere, each hugging its own content instead of stretching a phone
     number across a third of the viewport. */
  .ftr-grid {
    display: grid; gap: var(--spacing-s6) clamp(40px, 6vw, 104px);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), max-content));
  }
  .ftr-col {
    display: grid; grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-s1); align-content: start; min-width: 0;
  }
  .ftr-col > * { min-width: 0; }
  .ftr-col p { margin: 0; }
  /* `.ftr-col p` is one class plus one element and outranks a bare class, so
     the label's own margin is written at the same weight rather than with an
     `!important` that the next edit would have to fight. */
  .ftr-col .ftr-h {
    font-family: var(--font-mono); font-size: var(--text-eyebrow);
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--surface-ink-2); margin-bottom: var(--spacing-s2);
  }
  .ftr-addr { display: grid; gap: 2px; font-style: normal; }
  /* An implicit `auto` track sizes to max-content and a grid item's default
     `min-width: auto` resolves to min-content, so an unpinned address grows to
     fit its longest line and widens the whole document. Both are pinned above. */
  .ftr-social {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0 var(--spacing-s5);
  }
  /* Not inline-flex: an inline-flex link sizes to max-content and will not
     wrap. Padding gives the touch height instead. `:not(.ftr-mark)` because
     this rule is one class plus one element and outranks the mark's own
     `display: grid`, which flattened the lockup onto a single line. */
  .ftr a:not(.ftr-mark) { color: var(--surface-ink); text-decoration: none; display: inline-block; padding-block: 5px; }
  @media (any-hover: hover) { .ftr a:not(.ftr-mark):hover { text-decoration: underline; text-underline-offset: 0.2em; } }
  @media (any-hover: hover) { .ftr-mark:hover .ftr-mark-name { text-decoration: underline; text-underline-offset: 0.12em; } }

  /* --- the credentials ---------------------------------------------------- */
  .ftr-legal {
    display: grid; gap: var(--spacing-s2);
    padding-top: var(--spacing-s5);
    border-top: 1px solid var(--surface-line);
  }
  .ftr-firm { margin: 0; font-family: var(--font-serif); font-size: var(--text-h4); color: var(--surface-ink); }
  .ftr-note { margin: 0; color: var(--surface-ink-2); max-width: 72ch; font-size: var(--text-sm); }
</style>
