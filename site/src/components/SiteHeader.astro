---
import { t, langPath, type Lang } from "../i18n/ui";
import { ORG } from "../lib/org";
import { SERVICES } from "../lib/services";
import type { Alternates } from "../lib/seo";

interface Props { lang: Lang; alternates: Alternates; overHero?: boolean }
const { lang, alternates, overHero = false } = Astro.props;
const _ = t(lang);
const other: Lang = lang === "es" ? "en" : "es";
const otherHref = other === "es" ? alternates.es : alternates.en;

const nav = [
  { href: langPath(lang, "servicios"), label: _("nav.services") },
  { href: langPath(lang, "juan-campos"), label: _("nav.attorney") },
  { href: langPath(lang, "consulta"), label: _("nav.consultation") },
];
---
<header class="hdr" data-header data-over={overHero ? "" : undefined}>
  <div class="hdr-inner wrap-wide">
    <a class="hdr-mark" href={langPath(lang)}>
      <span class="hdr-mark-name">Campos</span>{" "}
      <span class="hdr-mark-rest">Immigration Law</span>
    </a>

    <nav class="hdr-nav">
      {nav.map((item) => (
        <a class="hdr-link" href={item.href} aria-current={Astro.url.pathname === item.href ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hdr-actions">
      <a class="hdr-phone apparatus" href={`tel:${ORG.phone.value}`}>{ORG.phoneDisplay.value}</a>
      <a class="hdr-pay" href={langPath(lang, "pagos")}>{_("nav.payment")}</a>
      <a class="hdr-lang" href={otherHref} lang={other} hreflang={other} aria-label={other === "en" ? _("lang.en") : _("lang.es")}>
        <span aria-hidden="true">{lang === "es" ? "EN" : "ES"}</span>
      </a>
      <a class="btn btn-primary hdr-cta" href={langPath(lang, "consulta")}>
        {_("cta.book")}
      </a>
      <button class="hdr-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-menu">
        <span class="sr-only" data-menu-label>{_("a11y.menu")}</span>
        <span class="hdr-toggle-bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <!-- Mobile drawer: ruled rows, always labelled, never a grid of icons. -->
  <div class="drawer" id="site-menu" data-menu hidden>
    <nav class="drawer-inner wrap">
      <ul class="drawer-list">
        <li class="drawer-group">
          <p class="drawer-group-name">{_("nav.services")}</p>
          <ul>
            {SERVICES.map((m) => (
              <li><a class="drawer-link" href={langPath(lang, m.slug)}>{m.name[lang]}</a></li>
            ))}
          </ul>
        </li>
        {nav.map((item) => (
          <li><a class="drawer-link drawer-link--big" href={item.href}>{item.label}</a></li>
        ))}
        <li><a class="drawer-link drawer-link--big" href={langPath(lang, "pagos")}>{_("nav.payment")}</a></li>
      </ul>
      <div class="drawer-actions">
        <a class="btn btn-primary" href={`tel:${ORG.phone.value}`}>{_("cta.call")} {ORG.phoneDisplay.value}</a>
        <a class="btn btn-secondary" href={otherHref} lang={other} hreflang={other}>{other === "en" ? _("lang.en") : _("lang.es")}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 100;
    background: color-mix(in srgb, var(--color-paper) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--color-line);
    transition: padding-block var(--d-state) var(--ease-state);
  }
  .hdr-inner {
    display: flex; align-items: center; gap: var(--spacing-s3);
    padding-block: var(--spacing-s4);
    transition: padding-block var(--d-state) var(--ease-state);
  }
  @media (min-width: 480px) { .hdr-inner { gap: var(--spacing-s5); } }
  /* The scrolled state is designed, not incidental: the bar condenses and the
     phone number stays reachable at every scroll position. */
  .hdr[data-scrolled] .hdr-inner { padding-block: var(--spacing-s2); }

  /* A two-line lockup: the name in the serif, the descriptor set underneath it
     in the mono, both flush left. The previous inline version put an 11px mono
     descriptor on the same baseline as a 22px serif name, which is the exact
     geometry of a superscript, and that is how it read. Stacked, the two
     lines share a left edge and a width, and the eye takes them as one mark. */
  .hdr-mark {
    display: grid; grid-template-columns: minmax(0, 1fr); align-content: center;
    row-gap: 3px;
    text-decoration: none; color: var(--color-ink);
    /* Shrinkable, so a 320px screen does not push the actions off-canvas. */
    flex: 0 1 auto; min-width: 0; overflow: hidden;
    /* WCAG 2.2 SC 2.5.8 wants 24px; the lockup's own box is 36. */
    min-height: 44px; padding-block: 4px;
  }
  .hdr-mark-name {
    font-family: var(--font-serif); font-size: var(--text-h4); line-height: 1;
    font-weight: 400; letter-spacing: -0.02em; white-space: nowrap;
  }
  .hdr-mark-rest {
    white-space: nowrap;
    font-family: var(--font-mono); font-size: 0.62rem; line-height: 1;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-ink-2);
  }
  .hdr[data-scrolled] .hdr-mark-rest { display: none; }
  /* Below 420px only the name survives; the descriptor is in the <title> and
     in the footer, so nothing is lost. */
  @media (max-width: 419px) { .hdr-mark-rest { display: none; } }

  .hdr-nav { display: none; gap: var(--spacing-s6); margin-inline-start: auto; }
  .hdr-link {
    text-decoration: none; color: var(--color-ink); white-space: nowrap;
    font-weight: var(--font-weight-medium); font-size: var(--text-base);
    padding-block: var(--spacing-s2);
    border-bottom: 2px solid transparent;
    transition: border-color var(--d-quick) var(--ease-state);
  }
  .hdr-link[aria-current="page"] { border-bottom-color: var(--color-accent); }
  @media (any-hover: hover) { .hdr-link:hover { border-bottom-color: var(--color-line-strong); } }

  .hdr-actions { display: flex; align-items: center; gap: var(--spacing-s2); margin-inline-start: auto; flex: none; }
  @media (min-width: 480px) { .hdr-actions { gap: var(--spacing-s3); } }
  .hdr-nav + .hdr-actions { margin-inline-start: 0; }
  .hdr-phone, .hdr-pay { display: none; text-decoration: none; }
  .hdr-phone { color: var(--color-ink); font-size: var(--text-sm); }
  .hdr-pay { color: var(--color-ink-2); font-size: var(--text-sm); font-weight: var(--font-weight-medium); }
  @media (any-hover: hover) { .hdr-phone:hover, .hdr-pay:hover { color: var(--color-accent-ink); } }

  .hdr-lang {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 44px; min-height: 44px;
    font-family: var(--font-mono); font-size: var(--text-sm); letter-spacing: 0.08em;
    text-decoration: none; color: var(--color-ink);
    border: 1px solid var(--color-line-strong); border-radius: var(--radius-sm);
  }
  @media (any-hover: hover) { .hdr-lang:hover { border-color: var(--color-ink); } }

  .hdr-cta { display: none; }

  .hdr-toggle {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; padding: 0;
    background: transparent; border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm); cursor: pointer;
  }
  .hdr-toggle-bars { display: grid; gap: 5px; width: 18px; }
  .hdr-toggle-bars i { display: block; height: 1.5px; background: var(--color-ink); }

  /* 1160, not 1024. At exactly 1024 the wordmark, four nav items, the phone
     number, the pay link, the language control and the booking button do not
     fit on one line, so the flex items shrank past their content and the link
     labels broke in two: the bar rendered 109px tall instead of 81, and the
     wordmark was clipped to 40px. The drawer covers everything below this. */
  @media (min-width: 1160px) {
    .hdr-nav { display: flex; }
    .hdr-phone, .hdr-pay, .hdr-cta { display: inline-flex; }
    .hdr-toggle { display: none; }
  }

  /* --- drawer --- */
  /* The drawer is a fixed child of the header, and the header carries a
     backdrop-filter, which makes the header the containing block for fixed
     descendants. So `bottom: 0` resolved to the *header's* bottom edge and the
     drawer was laid out upward from there: at 390x844 its box was -692 to 76,
     which is off the top of the screen with only its last 76px left, sitting
     over the button that opens it. The menu opened onto nothing and could not
     be closed by tapping the control again.

     Anchored from the top instead, `100%` is the header's own height, which is
     exactly where the drawer should start, and it stays correct when the bar
     condenses on scroll. */
  .drawer {
    position: fixed;
    left: 0; right: 0;
    top: 100%; bottom: auto;
    height: calc(100dvh - 100%);
    background: var(--color-paper); overflow-y: auto;
    border-top: 1px solid var(--color-line);
  }
  .drawer[hidden] { display: none; }
  .drawer-inner { padding-block: var(--spacing-s6) var(--spacing-s9); }
  .drawer-list { list-style: none; }
  .drawer-group { padding-block: var(--spacing-s4); border-bottom: 1px solid var(--color-line); }
  .drawer-group-name {
    font-family: var(--font-mono); font-size: var(--text-eyebrow);
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-accent-ink);
    margin-bottom: var(--spacing-s2);
  }
  .drawer-group ul { list-style: none; }
  .drawer-link {
    display: flex; align-items: baseline; min-height: 44px;
    padding-block: var(--spacing-s2);
    text-decoration: none; color: var(--color-ink); font-size: var(--text-base);
  }
  .drawer-link--big {
    font-size: var(--text-h4); font-weight: var(--font-weight-medium);
    border-bottom: 1px solid var(--color-line); padding-block: var(--spacing-s4);
  }
  .drawer-actions { display: grid; gap: var(--spacing-s3); margin-top: var(--spacing-s7); }
  @media (min-width: 1160px) { .drawer { display: none !important; } }

  /* --- overlay state, while the header is over the opening frame ---------
     Same bar, same items, same order. Only the ground changes: no fill, a
     hairline in white instead of stone, and light ink. The script removes
     `data-over` once the frame has scrolled past, and the transition below is
     what makes that read as the bar settling rather than blinking. */
  :global(html.js-on) .hdr[data-over] {
    background: transparent;
    /* Not `none`. Any backdrop-filter other than none makes this element the
       containing block for the fixed drawer inside it, and the drawer is
       anchored with `top: 100%` against exactly that. Dropping the filter here
       would silently re-anchor the drawer to the viewport in this state only.
       `saturate(1)` is a no-op, so the photograph under the bar stays crisp. */
    backdrop-filter: saturate(1);
    border-bottom-color: rgb(252 252 250 / 0.14);
  }
  .hdr {
    transition:
      padding-block var(--d-state) var(--ease-state),
      background-color var(--d-state) var(--ease-state),
      border-color var(--d-state) var(--ease-state);
  }
  :global(html.js-on) .hdr[data-over] .hdr-mark,
  :global(html.js-on) .hdr[data-over] .hdr-link,
  :global(html.js-on) .hdr[data-over] .hdr-phone { color: var(--color-paper); }
  :global(html.js-on) .hdr[data-over] .hdr-mark-rest { color: rgb(252 252 250 / 0.66); }
  :global(html.js-on) .hdr[data-over] .hdr-pay { color: rgb(252 252 250 / 0.72); }
  :global(html.js-on) .hdr[data-over] .hdr-toggle-bars i { background: var(--color-paper); }
  @media (any-hover: hover) {
    :global(html.js-on) .hdr[data-over] .hdr-link:hover { border-bottom-color: rgb(252 252 250 / 0.6); }
    :global(html.js-on) .hdr[data-over] .hdr-phone:hover,
    :global(html.js-on) .hdr[data-over] .hdr-pay:hover { color: var(--color-brass-light); }
  }
  :global(html.js-on) .hdr[data-over] .hdr-link[aria-current="page"] { border-bottom-color: var(--color-brass-light); }

  /* Pills. The one shape borrowed wholesale from the reference, because it is
     a shape and not a type decision: an outlined capsule for the secondary
     controls, a filled one for the booking action. */
  .hdr-lang, .hdr-toggle, .hdr-cta { border-radius: 999px; }
  .hdr-cta { padding-inline: var(--spacing-s5); }
  :global(html.js-on) .hdr[data-over] .hdr-lang,
  :global(html.js-on) .hdr[data-over] .hdr-toggle { border-color: rgb(252 252 250 / 0.34); color: var(--color-paper); }
  @media (any-hover: hover) {
    :global(html.js-on) .hdr[data-over] .hdr-lang:hover,
    :global(html.js-on) .hdr[data-over] .hdr-toggle:hover { border-color: var(--color-paper); }
  }
  :global(html.js-on) .hdr[data-over] .hdr-cta {
    background: transparent;
    color: var(--color-paper);
    border: 1px solid rgb(252 252 250 / 0.34);
  }
  @media (any-hover: hover) {
    :global(html.js-on) .hdr[data-over] .hdr-cta:hover { background: var(--color-paper); color: var(--color-navy-deep); border-color: var(--color-paper); }
  }
</style>
