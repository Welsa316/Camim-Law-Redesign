---
import { langPath, type Lang } from "../i18n/ui";
import { liveGroups, mattersInGroup } from "../lib/services";

interface Props { lang: Lang }
const { lang } = Astro.props;
const groups = liveGroups();
const servicesPath = langPath(lang, lang === "es" ? "servicios" : "services");
---
<!--
  Navigation, not a quiz. Nothing is collected and nothing is scored, which
  keeps it clear of Rule 4-1.18 and of anything that could read as an
  assessment of the reader's case.
-->
<div class="finder">
  <div class="editorial">
    <div>
      <p class="eyebrow">{lang === "es" ? "Por dónde empezar" : "Where to start"}</p>
    </div>
    <div>
      <h2 class="h2">{lang === "es" ? "¿Cuál es su situación?" : "What is your situation?"}</h2>
      <p class="lead finder-lead">
        {lang === "es"
          ? "Elija lo que más se parezca a su caso. Le llevamos a la explicación, no a un formulario."
          : "Pick whichever is closest to your case. It takes you to an explanation, not to a form."}
      </p>

      <ul class="rows finder-rows" data-stagger>
        {groups.map((g) => {
          const matters = mattersInGroup(g.id);
          return (
            <li class="row-item" data-reveal="text">
              <a class="row-link" href={`${servicesPath}#${g.id}`}>
                <span class="row-title">{g.situation[lang]}</span>
                <span class="row-arrow" aria-hidden="true">&rarr;</span>
                <span class="row-line">
                  {matters.map((m) => m.name[lang]).join(" · ")}
                </span>
              </a>
            </li>
          );
        })}
        <li class="row-item" data-reveal="text">
          <a class="row-link" href={langPath(lang, lang === "es" ? "consulta" : "consultation")}>
            <span class="row-title">{lang === "es" ? "No estoy seguro" : "I am not sure"}</span>
            <span class="row-arrow" aria-hidden="true">&rarr;</span>
            <span class="row-line">
              {lang === "es"
                ? "Cuéntenos qué está pasando y le decimos si podemos ayudarle."
                : "Tell us what is happening and we will say whether we can help."}
            </span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</div>

<style>
  .finder-lead { margin-block: var(--spacing-s4) var(--spacing-s6); }
  .finder-rows { margin-top: var(--spacing-s5); }
</style>
