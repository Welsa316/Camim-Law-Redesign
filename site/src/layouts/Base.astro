---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import MobileBar from "../components/MobileBar.astro";
import { t, type Lang } from "../i18n/ui";
import { abs, hreflang, type Alternates } from "../lib/seo";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  alternates: Alternates;
  schema?: string;
  ogImage?: string;
  noindex?: boolean;
  /** The page opens on a dark full-bleed frame, so the header sits over it. */
  overHero?: boolean;
}

const { lang, title, description, path, alternates, schema, ogImage = "/img/og-default.jpg", noindex = false, overHero = false } = Astro.props;
const _ = t(lang);
const canonical = abs(path);
const alts = hreflang(alternates);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    {alts.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Campos Immigration Law" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "es" ? "es_US" : "en_US"} />
    <meta property="og:image" content={abs(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Campos Immigration Law, Orlando, Florida" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(ogImage)} />

    <meta name="theme-color" content="#0B1F33" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href="/fonts/figtree-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-400.woff2" as="font" type="font/woff2" crossorigin />

    {schema && <script type="application/ld+json" set:html={schema} />}

    <script is:inline>
      // Applied in the head, before first paint, so reveal start states never
      // cause a flash of composed-then-hidden content. If this script never
      // runs, the class is absent and the page renders fully composed —
      // which is the failure mode we want.
      (function () {
        try {
          // Anything that only stays correct because a script keeps it correct
          // is gated on this. The overlay header is the case in point: nothing
          // can turn it off on scroll if scripting never runs.
          document.documentElement.classList.add("js-on");
          if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            document.documentElement.classList.add("js-reveal");
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{_("a11y.skip")}</a>
    <SiteHeader lang={lang} alternates={alternates} overHero={overHero} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <MobileBar lang={lang} />
    <script src="../scripts/app.ts"></script>
    <script src="../scripts/motion.ts"></script>
    <script src="../scripts/gallery.ts"></script>
  </body>
</html>
