---
import Base from "../layouts/Base.astro";
import { t, langPath } from "../i18n/ui";
import { ORG } from "../lib/org";
const lang = "es" as const;
const _ = t(lang);
---
<Base lang={lang} title={`${_("notFound.title")} — ${ORG.name.value}`} description={_("notFound.body")} path="/404/" alternates={{ es: "/404/", en: "/404/" }} noindex>
  <section class="nf wrap" data-surface="paper">
    <h1 class="h1">{_("notFound.title")}</h1>
    <p class="lead">{_("notFound.body")}</p>
    <p class="nf-call">
      <a class="btn btn-primary" href={langPath("es")}>{_("notFound.home")}</a>
      <a class="btn btn-secondary" href={langPath("es", "servicios")}>{_("notFound.services")}</a>
    </p>
  </section>
</Base>
<style>
  .nf { padding-block: var(--spacing-s9) var(--section-y); display: grid; gap: var(--spacing-s4); }
  .nf-en { color: var(--color-ink-2); }
  .nf-rows { margin-top: var(--spacing-s5); max-width: var(--container-m-read); }
  .nf-call { margin-top: var(--spacing-s5); }
</style>
