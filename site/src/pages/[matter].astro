---
import MatterPage from "../components/MatterPage.astro";
import { SERVICES } from "../lib/services";

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { matter: s.slug }, props: { service: s } }));
}
const { service } = Astro.props;
---
<MatterPage lang="es" service={service} />
